diff --git a/algorithm/test/qa_FastFFT.cpp b/algorithm/test/qa_FastFFT.cpp
new file mode 100644
index 0000000..4d87969
--- /dev/null
+++ b/algorithm/test/qa_FastFFT.cpp
@@ -0,0 +1,132 @@
+#include <boost/ut.hpp>
+
+#include <cmath>
+#include <complex>
+#include <format>
+#include <limits>
+#include <numbers>
+#include <random>
+#include <vector>
+
+#include <gnuradio-4.0/algorithm/fourier/FastFFT.hpp>
+#include <gnuradio-4.0/algorithm/fourier/fft.hpp>
+
+namespace {
+
+template<typename T>
+std::vector<std::complex<T>> randomSignal(std::size_t N) {
+    std::mt19937                      generator(static_cast<std::uint32_t>(N));
+    std::uniform_real_distribution<T> uniform(T(-1), T(1));
+    std::vector<std::complex<T>>      signal(N);
+    for (auto& z : signal) {
+        z = {uniform(generator), uniform(generator)};
+    }
+    return signal;
+}
+
+template<typename T>
+std::vector<std::complex<double>> directDft(const std::vector<std::complex<T>>& x) {
+    const std::size_t                 N = x.size();
+    std::vector<std::complex<double>> X(N);
+    for (std::size_t k = 0UZ; k < N; ++k) {
+        for (std::size_t n = 0UZ; n < N; ++n) {
+            const std::size_t phaseIndex = (n * k) % N; // exact reduction keeps the reference accurate for large N
+            X[k] += std::complex<double>(x[n]) * std::polar(1.0, -2.0 * std::numbers::pi * static_cast<double>(phaseIndex) / static_cast<double>(N));
+        }
+    }
+    return X;
+}
+
+template<typename T, typename U>
+double relativeL2Error(const std::vector<std::complex<T>>& actual, const std::vector<std::complex<U>>& expected) {
+    double errorSquared    = 0.0;
+    double expectedSquared = 0.0;
+    for (std::size_t i = 0UZ; i < actual.size(); ++i) {
+        errorSquared += std::norm(std::complex<double>(actual[i]) - std::complex<double>(expected[i]));
+        expectedSquared += std::norm(std::complex<double>(expected[i]));
+    }
+    return std::sqrt(errorSquared / expectedSquared);
+}
+
+template<typename T>
+double toleranceFor(std::size_t N) { // rounding error of a radix-r FFT grows with the number of passes, ~log2(N)
+    return 4.0 * static_cast<double>(std::numeric_limits<T>::epsilon()) * std::log2(static_cast<double>(N));
+}
+
+template<typename T>
+std::vector<std::complex<T>> fastForward(const std::vector<std::complex<T>>& in) {
+    gr::algorithm::FastFFT<T>    fft;
+    std::vector<std::complex<T>> out(in.size());
+    fft.resize(in.size());
+    fft.forward(in, out);
+    return out;
+}
+
+} // namespace
+
+const boost::ut::suite<"FastFFT"> fastFFTTests = [] {
+    using namespace boost::ut;
+    using gr::algorithm::FastFFT;
+
+    if constexpr (!gr::algorithm::kFastFFTHasNativeSimd) {
+        skip / "FastFFT needs a native std::simd backend"_test = [] {};
+        return;
+    }
+
+    "matches a direct DFT for every power-of-two size from 64 to 4096"_test = []<typename T> {
+        for (std::size_t N = FastFFT<T>::kMinSize; N <= 4096UZ; N *= 2UZ) {
+            const auto signal = randomSignal<T>(N);
+            const auto error  = relativeL2Error(fastForward(signal), directDft(signal));
+            expect(le(error, toleranceFor<T>(N))) << std::format("N={} relative L2 error {:.3g}", N, error);
+        }
+    } | std::tuple<float, double>{};
+
+    "a unit impulse transforms to all ones"_test = []<typename T> {
+        for (std::size_t N : {64UZ, 1024UZ, 1UZ << 16UZ}) {
+            std::vector<std::complex<T>> impulse(N);
+            impulse[0]                 = T(1);
+            const auto        spectrum = fastForward(impulse);
+            const std::vector ones(N, std::complex<T>(1));
+            expect(le(relativeL2Error(spectrum, ones), toleranceFor<T>(N))) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+
+    "a complex tone at bin k transforms to N at bin k and zero elsewhere"_test = []<typename T> {
+        for (std::size_t N : {64UZ, 4096UZ, 1UZ << 18UZ}) {
+            const std::size_t            bin = N / 8UZ + 3UZ;
+            std::vector<std::complex<T>> tone(N);
+            for (std::size_t n = 0UZ; n < N; ++n) {
+                tone[n] = std::complex<T>(std::polar(1.0, 2.0 * std::numbers::pi * static_cast<double>((bin * n) % N) / static_cast<double>(N)));
+            }
+            std::vector<std::complex<double>> expected(N);
+            expected[bin] = static_cast<double>(N);
+            expect(le(relativeL2Error(fastForward(tone), expected), toleranceFor<T>(N))) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+
+    "an in-place transform equals the out-of-place one"_test = []<typename T> {
+        constexpr std::size_t N          = 2048UZ;
+        auto                  data       = randomSignal<T>(N);
+        const auto            outOfPlace = fastForward(data);
+        FastFFT<T>            fft;
+        fft.resize(N);
+        fft.forward(data, data);
+        expect(eq(relativeL2Error(data, outOfPlace), 0.0));
+    } | std::tuple<float, double>{};
+
+    "gr::algorithm::FFT gives the same spectrum with FastFFT on and off"_test = []<typename T> {
+        for (std::size_t N : {64UZ, 512UZ, 8192UZ}) {
+            const auto                                           signal = randomSignal<T>(N);
+            gr::algorithm::FFT<std::complex<T>, std::complex<T>> withFastFFT;
+            gr::algorithm::FFT<std::complex<T>, std::complex<T>> withoutFastFFT;
+            withoutFastFFT.useFastFFT = false;
+            std::vector<std::complex<T>> spectrumFast(N);
+            std::vector<std::complex<T>> spectrumReference(N);
+            withFastFFT.compute(signal, spectrumFast);
+            withoutFastFFT.compute(signal, spectrumReference);
+            expect(le(relativeL2Error(spectrumFast, spectrumReference), 2.0 * toleranceFor<T>(N))) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+};
+
+int main() { /* not needed for UT */ }
