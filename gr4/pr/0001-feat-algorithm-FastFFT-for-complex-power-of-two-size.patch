+#ifndef GNURADIO_ALGORITHM_FASTFFT_HPP
+#define GNURADIO_ALGORITHM_FASTFFT_HPP
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cassert>
+#include <cmath>
+#include <complex>
+#include <concepts>
+#include <cstddef>
+#include <cstring>
+#include <numbers>
+#include <span>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#include <gnuradio-4.0/MemoryAllocators.hpp>
+
+#include <vir/simd.h>
+
+namespace gr::algorithm {
+
+#ifdef VIR_HAVE_STD_SIMD
+inline constexpr bool kFastFFTHasNativeSimd = true;
+#else
+inline constexpr bool kFastFFTHasNativeSimd = false; // vir's array-based fallback (libc++, Emscripten) is slower than SimdFFT
+#endif
+
+namespace detail {
+
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpsabi" // the kernel is always inlined, so the vector-argument ABI note does not apply
+#endif
+
+template<std::floating_point T>
+struct FastFFTKernel {
+    static constexpr std::size_t kNativeLanes = vir::stdx::native_simd<T>::size();
+    // at least two complex values per vector: on 16-byte targets (SSE, NEON) double uses a pair of registers
+    using V                        = std::conditional_t<kNativeLanes >= 4UZ, vir::stdx::native_simd<T>, vir::stdx::simd<T, vir::stdx::simd_abi::deduce_t<T, 4UZ>>>;
+    static constexpr std::size_t W = V::size();
+    static constexpr std::size_t C = W / 2UZ;
+    static_assert(C >= 2UZ && C <= 8UZ);
+
+    static constexpr T kInvSqrt2 = T(1) / std::numbers::sqrt2_v<T>;
+    static constexpr T kCosPi8   = T(0.92387953251128675613);
+    static constexpr T kSinPi8   = T(0.38268343236508977173);
+
+    // std::simd has no two-input shuffle and vir::simd_permute of a concat lowers to element moves (~3x the whole stage),
+    // so the shuffles use the compiler's generic vector type of the same width: no ISA intrinsics, still width-generic
+    typedef T GenericVector __attribute__((vector_size(sizeof(T) * W)));
+
+    [[gnu::always_inline]] static GenericVector toGeneric(const V& v) {
+        if constexpr (std::is_trivially_copyable_v<V> && sizeof(V) == sizeof(GenericVector)) {
+            return std::bit_cast<GenericVector>(v);
+        } else {
+            GenericVector r;
+            v.copy_to(reinterpret_cast<T*>(&r), vir::stdx::element_aligned);
+            return r;
+        }
+    }
+
+    [[gnu::always_inline]] static V fromGeneric(const GenericVector& g) {
+        if constexpr (std::is_trivially_copyable_v<V> && sizeof(V) == sizeof(GenericVector)) {
+            return std::bit_cast<V>(g);
+        } else {
+            return V(reinterpret_cast<const T*>(&g), vir::stdx::element_aligned);
+        }
+    }
+
+    [[gnu::always_inline]] static V    load(const T* p) { return V(p, vir::stdx::element_aligned); }
+    [[gnu::always_inline]] static void store(const V& v, T* p) { v.copy_to(p, vir::stdx::element_aligned); }
+
+    [[gnu::always_inline]] static V minusPlus() {
+        return V([](auto i) { return (i & 1) ? T(1) : -T(1); });
+    }
+    [[gnu::always_inline]] static V plusMinus() {
+        return V([](auto i) { return (i & 1) ? -T(1) : T(1); });
+    }
+
+    template<std::size_t... J>
+    [[gnu::always_inline]] static V swapRealImag(const V& v, std::index_sequence<J...>) {
+        const GenericVector g = toGeneric(v);
+        return fromGeneric(__builtin_shufflevector(g, g, int(J ^ 1UZ)...));
+    }
+    [[gnu::always_inline]] static V swapRealImag(const V& v) { return swapRealImag(v, std::make_index_sequence<W>{}); }
+
+    [[gnu::always_inline]] static V broadcastComplex(const T* p) {
+        if constexpr (sizeof(T) == 4UZ) { // one 64-bit broadcast
+            using VDouble = vir::stdx::simd<double, vir::stdx::simd_abi::deduce_t<double, W / 2UZ>>;
+            double pair;
+            std::memcpy(&pair, p, sizeof(pair));
+            return std::bit_cast<V>(VDouble(pair));
+        } else { // the generator compiles to a 128-bit broadcast; a shuffle of a two-lane vector measured 2x slower
+            return V([p](auto i) { return p[i & 1]; });
+        }
+    }
+
+    // a * b + c is spelled out because vir::stdx::fma is not inlined by libstdc++; -ffp-contract fuses it
+    [[gnu::always_inline]] static V complexMultiply(const V& z, const V& realPair, const V& imagSigned) { return z * realPair + swapRealImag(z) * imagSigned; }
+
+    [[gnu::always_inline]] static V multiplyMinusJ(const V& v) { return swapRealImag(v) * plusMinus(); }
+    [[gnu::always_inline]] static V multiplyW8(const V& v) { return swapRealImag(v) * (plusMinus() * kInvSqrt2) + v * kInvSqrt2; }
+    [[gnu::always_inline]] static V multiplyW8Cubed(const V& v) { return swapRealImag(v) * (plusMinus() * kInvSqrt2) + v * -kInvSqrt2; }
+
+    [[gnu::always_inline]] static void butterfly4(const V& a, const V& b, const V& c, const V& d, V& y0, V& y1, V& y2, V& y3) {
+        const V apc     = a + c;
+        const V amc     = a - c;
+        const V bpd     = b + d;
+        const V bmdSwap = swapRealImag(b - d);
+        y0              = apc + bpd;
+        y2              = apc - bpd;
+        y1              = bmdSwap * plusMinus() + amc;
+        y3              = bmdSwap * minusPlus() + amc;
+    }
+
+    [[gnu::always_inline]] static void butterfly8(const V* a, V* y) {
+        const V b0 = a[0] + a[4];
+        const V b1 = a[1] + a[5];
+        const V b2 = a[2] + a[6];
+        const V b3 = a[3] + a[7];
+        const V c0 = a[0] - a[4];
+        const V c1 = multiplyW8(a[1] - a[5]);
+        const V c2 = multiplyMinusJ(a[2] - a[6]);
+        const V c3 = multiplyW8Cubed(a[3] - a[7]);
+        butterfly4(b0, b1, b2, b3, y[0], y[2], y[4], y[6]);
+        butterfly4(c0, c1, c2, c3, y[1], y[3], y[5], y[7]);
+    }
+
+    [[gnu::always_inline]] static void butterfly16(const V* a, V* y) {
+        V b[4][4];
+        for (std::size_t j = 0UZ; j < 4UZ; ++j) {
+            butterfly4(a[j], a[j + 4], a[j + 8], a[j + 12], b[j][0], b[j][1], b[j][2], b[j][3]);
+        }
+        b[1][1] = complexMultiply(b[1][1], V(kCosPi8), minusPlus() * -kSinPi8); // W16^1
+        b[1][2] = multiplyW8(b[1][2]);
+        b[1][3] = complexMultiply(b[1][3], V(kSinPi8), minusPlus() * -kCosPi8); // W16^3
+        b[2][1] = multiplyW8(b[2][1]);
+        b[2][2] = multiplyMinusJ(b[2][2]);
+        b[2][3] = multiplyW8Cubed(b[2][3]);
+        b[3][1] = complexMultiply(b[3][1], V(kSinPi8), minusPlus() * -kCosPi8); // W16^3
+        b[3][2] = multiplyW8Cubed(b[3][2]);
+        b[3][3] = complexMultiply(b[3][3], V(-kCosPi8), minusPlus() * kSinPi8); // W16^9
+        for (std::size_t k = 0UZ; k < 4UZ; ++k) {
+            butterfly4(b[0][k], b[1][k], b[2][k], b[3][k], y[k], y[k + 4], y[k + 8], y[k + 12]);
+        }
+    }
+
+    template<bool high, std::size_t... J>
+    [[gnu::always_inline]] static V interleaveComplex(const V& a, const V& b, std::index_sequence<J...>) {
+        constexpr auto sourceLane = [](std::size_t j) {
+            const std::size_t complexIndex = j / 2UZ;
+            return int((complexIndex & 1UZ) * W + 2UZ * (complexIndex / 2UZ + (high ? C / 2UZ : 0UZ)) + (j & 1UZ));
+        };
+        return fromGeneric(__builtin_shufflevector(toGeneric(a), toGeneric(b), sourceLane(J)...));
+    }
+    [[gnu::always_inline]] static V interleaveLow(const V& a, const V& b) { return interleaveComplex<false>(a, b, std::make_index_sequence<W>{}); }
+    [[gnu::always_inline]] static V interleaveHigh(const V& a, const V& b) { return interleaveComplex<true>(a, b, std::make_index_sequence<W>{}); }
+
+    // out holds the complex values of s[k] lane p at position 8p + k: three rounds of pairwise interleaving
+    [[gnu::always_inline]] static void transpose8(const V* s, V* out) {
+        V                              round1[8];
+        V                              round2[8];
+        constexpr std::array<int, 4UZ> kPairs = {0, 2, 1, 3};
+        for (std::size_t i = 0UZ; i < 4UZ; ++i) {
+            round1[2 * i]     = interleaveLow(s[kPairs[i]], s[kPairs[i] + 4]);
+            round1[2 * i + 1] = interleaveHigh(s[kPairs[i]], s[kPairs[i] + 4]);
+        }
+        for (std::size_t h = 0UZ; h < 2UZ; ++h) {
+            for (std::size_t i = 0UZ; i < 2UZ; ++i) {
+                round2[4 * h + 2 * i]     = interleaveLow(round1[4 * h + i], round1[4 * h + 2 + i]);
+                round2[4 * h + 2 * i + 1] = interleaveHigh(round1[4 * h + i], round1[4 * h + 2 + i]);
+            }
+        }
+        for (std::size_t i = 0UZ; i < 4UZ; ++i) {
+            out[2 * i]     = interleaveLow(round2[i], round2[4 + i]);
+            out[2 * i + 1] = interleaveHigh(round2[i], round2[4 + i]);
+        }
+    }
+};
+
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic pop
+#endif
+
+} // namespace detail
+
+/**
+ * Forward complex FFT for power-of-two sizes N >= 64 on native std::simd, out of place or in place, unnormalised.
+ * Stockham autosort [1]: a radix-8 first pass vectorised over butterflies and transposed in registers on the store,
+ * radix-16 middle passes vectorised over the stride with broadcast twiddles, and one twiddle-free final pass of radix 2, 4, 8 or 16.
+ * Holds scratch buffers, so one instance must not be used by two threads at once. Design and measurements: [2].
+ * [1] T. G. Stockham, "High-speed convolution and correlation," in Proc. AFIPS Spring Joint Comput. Conf., 1966, pp. 229-233.
+ * [2] D. Klein and Claude, "A portable std::simd FFT for GNU Radio 4," 2026. [Online]. Available: https://github.com/dennisklein/fft
+ */
+template<std::floating_point T>
+struct FastFFT {
+    using Kernel                          = detail::FastFFTKernel<T>;
+    using V                               = typename Kernel::V;
+    static constexpr std::size_t kMinSize = 64UZ;
+
+    struct Pass {
+        std::size_t n;
+        std::size_t s;
+        std::size_t radix;
+        std::size_t twiddleOffset;
+    };
+
+    std::size_t                               _size{0UZ};
+    std::vector<Pass>                         _passes;
+    std::vector<T>                            _twiddles;
+    std::vector<T, gr::allocator::Aligned<T>> _work;
+    std::vector<T, gr::allocator::Aligned<T>> _inPlaceCopy;
+
+    [[nodiscard]] std::size_t size() const noexcept { return _size; }
+
+    void resize(std::size_t N) {
+        assert(N >= kMinSize && std::has_single_bit(N));
+        constexpr std::size_t C       = Kernel::C;
+        const auto            twiddle = [](std::size_t k, std::size_t n) { return std::polar(1.0, -2.0 * std::numbers::pi * static_cast<double>(k) / static_cast<double>(n)); };
+
+        _size = N;
+        _passes.clear();
+        _twiddles.clear();
+        std::size_t n = N;
+        std::size_t s = 1UZ;
+        while (n > 1UZ) {
+            const std::size_t radix = s == 1UZ ? 8UZ : std::min(n, 16UZ);
+            const std::size_t m     = n / radix;
+            _passes.push_back({n, s, radix, _twiddles.size()});
+            if (s == 1UZ) { // per group of C butterflies, for k = 1..7: W values (re, re), then W values (-im, im)
+                for (std::size_t group = 0UZ; group < m / C; ++group) {
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        for (std::size_t j = 0UZ; j < C; ++j) {
+                            const T re = static_cast<T>(twiddle(k * (C * group + j), n).real());
+                            _twiddles.insert(_twiddles.end(), {re, re});
+                        }
+                        for (std::size_t j = 0UZ; j < C; ++j) {
+                            const T im = static_cast<T>(twiddle(k * (C * group + j), n).imag());
+                            _twiddles.insert(_twiddles.end(), {-im, im});
+                        }
+                    }
+                }
+            } else if (m > 1UZ) { // per butterfly p, for k = 1..15: (re, re, -im, im)
+                for (std::size_t p = 0UZ; p < m; ++p) {
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        const auto w = twiddle(k * p, n);
+                        _twiddles.insert(_twiddles.end(), {static_cast<T>(w.real()), static_cast<T>(w.real()), static_cast<T>(-w.imag()), static_cast<T>(w.imag())});
+                    }
+                }
+            }
+            n /= radix;
+            s *= radix;
+        }
+        _work.resize(2UZ * N);
+        _inPlaceCopy.resize(2UZ * N);
+    }
+
+    void forward(std::span<const std::complex<T>> in, std::span<std::complex<T>> out) {
+        assert(in.size() == _size && out.size() == _size);
+        const T* x = reinterpret_cast<const T*>(in.data());
+        T*       y = reinterpret_cast<T*>(out.data());
+        if (x == y) {
+            std::memcpy(_inPlaceCopy.data(), x, 2UZ * _size * sizeof(T));
+            x = _inPlaceCopy.data();
+        }
+        const std::size_t nPasses = _passes.size();
+        for (std::size_t i = 0UZ; i < nPasses; ++i) {
+            const bool lastPassIntoOut = (nPasses - 1UZ - i) % 2UZ == 0UZ; // passes alternate so that the last one writes to out
+            T*         dst             = lastPassIntoOut ? y : _work.data();
+            runPass(_passes[i], x, dst);
+            x = dst;
+        }
+    }
+
+    void runPass(const Pass& pass, const T* x, T* y) const {
+        constexpr std::size_t C = Kernel::C;
+        constexpr std::size_t W = Kernel::W;
+        const std::size_t     s = pass.s;
+        const std::size_t     m = pass.n / pass.radix;
+        if (pass.radix == 2UZ) {
+            for (std::size_t q = 0UZ; q < s; q += C) {
+                const V a = Kernel::load(x + 2 * q);
+                const V b = Kernel::load(x + 2 * (q + s));
+                Kernel::store(a + b, y + 2 * q);
+                Kernel::store(a - b, y + 2 * (q + s));
+            }
+        } else if (pass.radix == 4UZ) {
+            for (std::size_t q = 0UZ; q < s; q += C) {
+                V y0, y1, y2, y3;
+                Kernel::butterfly4(Kernel::load(x + 2 * q), Kernel::load(x + 2 * (q + s)), Kernel::load(x + 2 * (q + 2 * s)), Kernel::load(x + 2 * (q + 3 * s)), y0, y1, y2, y3);
+                Kernel::store(y0, y + 2 * q);
+                Kernel::store(y1, y + 2 * (q + s));
+                Kernel::store(y2, y + 2 * (q + 2 * s));
+                Kernel::store(y3, y + 2 * (q + 3 * s));
+            }
+        } else if (s == 1UZ) {
+            constexpr std::size_t kTwiddleValuesPerGroup = 7UZ * 2UZ * W;
+            const T*              t                      = _twiddles.data() + pass.twiddleOffset;
+            for (std::size_t p0 = 0UZ; p0 < m; p0 += C, t += kTwiddleValuesPerGroup) {
+                V a[8], o[8], transposed[8];
+                for (std::size_t k = 0UZ; k < 8UZ; ++k) {
+                    a[k] = Kernel::load(x + 2 * (p0 + k * m));
+                }
+                Kernel::butterfly8(a, o);
+                for (std::size_t k = 1UZ; k < 8UZ; ++k) {
+                    o[k] = Kernel::complexMultiply(o[k], Kernel::load(t + 2 * W * (k - 1)), Kernel::load(t + 2 * W * (k - 1) + W));
+                }
+                Kernel::transpose8(o, transposed);
+                for (std::size_t i = 0UZ; i < 8UZ; ++i) {
+                    Kernel::store(transposed[i], y + 2 * 8 * p0 + W * i);
+                }
+            }
+        } else if (pass.radix == 8UZ) { // final pass, m == 1: no twiddles
+            for (std::size_t q = 0UZ; q < s; q += C) {
+                V a[8], o[8];
+                for (std::size_t k = 0UZ; k < 8UZ; ++k) {
+                    a[k] = Kernel::load(x + 2 * (q + k * s));
+                }
+                Kernel::butterfly8(a, o);
+                for (std::size_t k = 0UZ; k < 8UZ; ++k) {
+                    Kernel::store(o[k], y + 2 * (q + k * s));
+                }
+            }
+        } else {
+            constexpr std::size_t kTwiddleValuesPerButterfly = 15UZ * 4UZ;
+            for (std::size_t p = 0UZ; p < m; ++p) {
+                const T* t  = _twiddles.data() + pass.twiddleOffset + kTwiddleValuesPerButterfly * p;
+                const T* xp = x + 2 * s * p;
+                T*       yp = y + 2 * s * 16 * p;
+                for (std::size_t q = 0UZ; q < s; q += C) {
+                    V a[16], o[16];
+                    for (std::size_t k = 0UZ; k < 16UZ; ++k) {
+                        a[k] = Kernel::load(xp + 2 * (q + k * s * m));
+                    }
+                    Kernel::butterfly16(a, o);
+                    Kernel::store(o[0], yp + 2 * q);
+                    for (std::size_t k = 1UZ; k < 16UZ; ++k) {
+                        Kernel::store(p == 0UZ ? o[k] : Kernel::complexMultiply(o[k], Kernel::broadcastComplex(t + 4 * (k - 1)), Kernel::broadcastComplex(t + 4 * (k - 1) + 2)), yp + 2 * (q + k * s));
+                    }
+                }
+            }
+        }
+    }
+};
+
+} // namespace gr::algorithm
+
+#endif // GNURADIO_ALGORITHM_FASTFFT_HPP
