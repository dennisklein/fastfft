Subject: [PATCH 08/11] perf(algorithm): experimental StockhamFFTFourStep (N1 x
 N2 with blocked columns) for bm_fft

---
 algorithm/benchmarks/StockhamFFTFourStep.hpp | 163 +++++++++++++++++++
 1 file changed, 163 insertions(+)
 create mode 100644 algorithm/benchmarks/StockhamFFTFourStep.hpp

diff --git a/algorithm/benchmarks/StockhamFFTFourStep.hpp b/algorithm/benchmarks/StockhamFFTFourStep.hpp
new file mode 100644
index 0000000..514b27c
--- /dev/null
+++ b/algorithm/benchmarks/StockhamFFTFourStep.hpp
@@ -0,0 +1,163 @@
+#ifndef GNURADIO_ALGORITHM_STOCKHAMFFTFOURSTEP_HPP
+#define GNURADIO_ALGORITHM_STOCKHAMFFTFOURSTEP_HPP
+
+#include <bit>
+#include <cassert>
+#include <cmath>
+#include <complex>
+#include <concepts>
+#include <cstddef>
+#include <numbers>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include <gnuradio-4.0/MemoryAllocators.hpp>
+#include <gnuradio-4.0/algorithm/fourier/StockhamFFT.hpp>
+
+namespace gr::algorithm {
+
+/**
+ * Forward complex FFT for power-of-two N >= kMinSize, out of place or in place, unnormalised, as the four-step decomposition N = N1 * N2 [1]:
+ * N1-point column FFTs on blocks of 8 adjacent columns (lane j = column j, no shuffles), each block in cache, fused with the twiddles W_N^(k1 n2) into a padded N1 x N2 scratch;
+ * then N2-point row FFTs with StockhamFFT, 8 rows at a time, transposed in registers into out[k2 N1 + k1]: two sweeps over memory (in -> scratch -> out), not log16 N.
+ * Holds scratch buffers, so one instance must not be used by two threads at once.
+ * [1] D. H. Bailey, "FFTs in external or hierarchical memory," J. Supercomputing, vol. 4, no. 1, pp. 23-35, 1990.
+ */
+template<std::floating_point T>
+struct StockhamFFTFourStep {
+    using Kernel                              = detail::StockhamKernel<T>;
+    using V                                   = typename Kernel::V;
+    static constexpr std::size_t kMinSize     = 1UZ << 10UZ;
+    static constexpr std::size_t kColumnBlock = 8UZ; // the first radix of StockhamFFT's default plan, the pass this kernel skips
+    static constexpr std::size_t kRowBlock    = 8UZ; // the height of Kernel::transpose8
+    static constexpr std::size_t kRowPadding  = 8UZ; // complex values; keeps power-of-two row strides out of one cache set
+    static constexpr std::size_t kColumnShift = 2UZ; // N1 = sqrt(N) / 4 beat sqrt(N) and sqrt(N) / 2 in a quick unpaired check on one AVX-512 host; not tuned
+
+    std::size_t                                                         _size{0UZ};
+    std::size_t                                                         _n1{0UZ};
+    std::size_t                                                         _n2{0UZ};
+    std::size_t                                                         _fineTwiddleBits{0UZ};
+    StockhamFFT<T>                                                      _columnFft; // planned for N1 * kColumnBlock points
+    StockhamFFT<T>                                                      _rowFft;
+    std::vector<T>                                                      _laneTwiddles; // per k1, per vector of a block row: W_N^(k1 j) as (re, re) pairs, then (-im, im) pairs
+    std::vector<std::complex<T>>                                        _coarseTwiddles;
+    std::vector<std::complex<T>>                                        _fineTwiddles;
+    std::vector<T, gr::allocator::Aligned<T>>                           _columnBlock;
+    std::vector<T, gr::allocator::Aligned<T>>                           _columnBlockWork;
+    std::vector<std::complex<T>, gr::allocator::Aligned<std::complex<T>>> _scratch; // N1 rows of N2 + kRowPadding
+    std::vector<std::complex<T>, gr::allocator::Aligned<std::complex<T>>> _rowTile; // kRowBlock rows of N2 + kRowPadding
+
+    [[nodiscard]] std::size_t size() const noexcept { return _size; }
+
+    void resize(std::size_t N) {
+        assert(N >= kMinSize && std::has_single_bit(N));
+        static_assert(kColumnBlock == 8UZ && kColumnBlock % Kernel::C == 0UZ);
+        constexpr std::size_t C       = Kernel::C;
+        constexpr std::size_t W       = Kernel::W;
+        const auto            twiddle = [N](std::size_t e) { return std::polar(1.0, -2.0 * std::numbers::pi * static_cast<double>(e) / static_cast<double>(N)); };
+        const std::size_t     log2N   = static_cast<std::size_t>(std::countr_zero(N));
+
+        _size            = N;
+        _n1              = 1UZ << std::max(3UZ, log2N / 2UZ - kColumnShift); // N1 >= kRowBlock; N2 >= 64 follows from N >= kMinSize
+        _n2              = N / _n1;
+        _fineTwiddleBits = (log2N + 1UZ) / 2UZ;
+        _columnFft.resize(_n1 * kColumnBlock);
+        _rowFft.resize(_n2);
+
+        _laneTwiddles.clear();
+        for (std::size_t k1 = 0UZ; k1 < _n1; ++k1) {
+            for (std::size_t v = 0UZ; v < kColumnBlock / C; ++v) {
+                for (std::size_t j = 0UZ; j < C; ++j) {
+                    const T re = static_cast<T>(twiddle(k1 * (v * C + j)).real());
+                    _laneTwiddles.insert(_laneTwiddles.end(), {re, re});
+                }
+                for (std::size_t j = 0UZ; j < C; ++j) {
+                    const T im = static_cast<T>(twiddle(k1 * (v * C + j)).imag());
+                    _laneTwiddles.insert(_laneTwiddles.end(), {-im, im});
+                }
+            }
+        }
+        assert(_laneTwiddles.size() == _n1 * (kColumnBlock / C) * 2UZ * W);
+        _coarseTwiddles.resize(N >> _fineTwiddleBits);
+        for (std::size_t h = 0UZ; h < _coarseTwiddles.size(); ++h) {
+            _coarseTwiddles[h] = std::complex<T>(twiddle(h << _fineTwiddleBits));
+        }
+        _fineTwiddles.resize(1UZ << _fineTwiddleBits);
+        for (std::size_t l = 0UZ; l < _fineTwiddles.size(); ++l) {
+            _fineTwiddles[l] = std::complex<T>(twiddle(l));
+        }
+        _columnBlock.resize(2UZ * _n1 * kColumnBlock);
+        _columnBlockWork.resize(2UZ * _n1 * kColumnBlock);
+        _scratch.resize(_n1 * (_n2 + kRowPadding));
+        _rowTile.resize(kRowBlock * (_n2 + kRowPadding));
+    }
+
+    void forward(std::span<const std::complex<T>> in, std::span<std::complex<T>> out) {
+        assert(in.size() == _size && out.size() == _size);
+        constexpr std::size_t C                  = Kernel::C;
+        constexpr std::size_t W                  = Kernel::W;
+        constexpr std::size_t kVectorsPerBlock   = kColumnBlock / C;
+        const std::size_t     N1                 = _n1;
+        const std::size_t     N2                 = _n2;
+        const std::size_t     rowStride          = N2 + kRowPadding;
+        const T*              x                  = reinterpret_cast<const T*>(in.data());
+        T*                    y                  = reinterpret_cast<T*>(out.data());
+        T*                    scratch            = reinterpret_cast<T*>(_scratch.data());
+        const std::size_t     fineTwiddleMask    = _fineTwiddles.size() - 1UZ;
+        const auto            columnPasses       = std::span(_columnFft._passes).subspan(1UZ); // the skipped first pass is the one that mixes the kColumnBlock columns
+        const auto            blockTwiddle       = [&](std::size_t e) { // W_N^e as a product of two small tables, so the twiddles of the whole matrix stay in cache
+            const std::complex<T> a = _coarseTwiddles[e >> _fineTwiddleBits];
+            const std::complex<T> b = _fineTwiddles[e & fineTwiddleMask];
+            return std::complex<T>(a.real() * b.real() - a.imag() * b.imag(), a.real() * b.imag() + a.imag() * b.real());
+        };
+
+        // the column sweep reads all of in before the row sweep writes out, so in == out needs no copy
+        for (std::size_t c0 = 0UZ; c0 < N2; c0 += kColumnBlock) {
+            T* src = _columnBlock.data();
+            T* dst = _columnBlockWork.data();
+            for (std::size_t n1 = 0UZ; n1 < N1; ++n1) {
+                for (std::size_t v = 0UZ; v < kVectorsPerBlock; ++v) {
+                    Kernel::store(Kernel::load(x + 2UZ * (n1 * N2 + c0 + v * C)), src + 2UZ * (n1 * kColumnBlock + v * C));
+                }
+            }
+            for (const auto& pass : columnPasses) {
+                _columnFft.runPass(pass, src, dst);
+                std::swap(src, dst);
+            }
+            for (std::size_t k1 = 0UZ; k1 < N1; ++k1) {
+                const std::complex<T> w         = blockTwiddle(k1 * c0);
+                const V               wRe(w.real());
+                const V               wImSigned = Kernel::minusPlus() * w.imag();
+                const T*              lane      = _laneTwiddles.data() + k1 * kVectorsPerBlock * 2UZ * W;
+                for (std::size_t v = 0UZ; v < kVectorsPerBlock; ++v) {
+                    const V z         = Kernel::load(src + 2UZ * (k1 * kColumnBlock + v * C));
+                    const V zLaneTurn = Kernel::complexMultiply(z, Kernel::load(lane + 2UZ * W * v), Kernel::load(lane + 2UZ * W * v + W));
+                    Kernel::store(Kernel::complexMultiply(zLaneTurn, wRe, wImSigned), scratch + 2UZ * (k1 * rowStride + c0 + v * C));
+                }
+            }
+        }
+
+        const T* tile = reinterpret_cast<const T*>(_rowTile.data());
+        for (std::size_t k1 = 0UZ; k1 < N1; k1 += kRowBlock) {
+            for (std::size_t r = 0UZ; r < kRowBlock; ++r) {
+                _rowFft.forward(std::span(_scratch).subspan((k1 + r) * rowStride, N2), std::span(_rowTile).subspan(r * rowStride, N2));
+            }
+            for (std::size_t k2 = 0UZ; k2 < N2; k2 += C) {
+                V rows[kRowBlock];
+                V columns[kRowBlock];
+                for (std::size_t r = 0UZ; r < kRowBlock; ++r) {
+                    rows[r] = Kernel::load(tile + 2UZ * (r * rowStride + k2));
+                }
+                Kernel::transpose8(rows, columns);
+                for (std::size_t i = 0UZ; i < kRowBlock; ++i) { // columns[i] holds complex values C i .. C i + C - 1 of the C x 8 block, k2-major
+                    Kernel::store(columns[i], y + 2UZ * ((k2 + C * i / kRowBlock) * N1 + k1 + C * i % kRowBlock));
+                }
+            }
+        }
+    }
+};
+
+} // namespace gr::algorithm
+
+#endif // GNURADIO_ALGORITHM_STOCKHAMFFTFOURSTEP_HPP
-- 
