+            expect(eq(fft.stockhamFFT.size(), expectStockham ? N : 0UZ)) << std::format("N={}", N);
+            if (!expectStockham) {
+                expect(eq(fft.simdFFT.size(), N)) << std::format("N={}", N);
+            } else {
