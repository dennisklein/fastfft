+#include <boost/ut.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <complex>
+#include <cstdint>
+#include <format>
+#include <limits>
+#include <numbers>
+#include <random>
+#include <ranges>
+#include <string>
+#include <vector>
+
+#include <gnuradio-4.0/algorithm/fourier/StockhamFFT.hpp>
+#include <gnuradio-4.0/algorithm/fourier/fft.hpp>
+
+namespace {
+
+using LongComplex = std::complex<long double>;
+
+template<typename T>
+std::vector<std::complex<T>> randomSignal(std::size_t N) {
+    std::mt19937                      generator(static_cast<std::uint32_t>(N));
+    std::uniform_real_distribution<T> uniform(T(-1), T(1));
+    std::vector<std::complex<T>>      signal(N);
+    for (auto& z : signal) {
+        z = {uniform(generator), uniform(generator)};
+    }
+    return signal;
+}
+
+std::vector<LongComplex> rootsOfUnity(std::size_t N) { // exp(-2 pi i j / N), j < N
+    std::vector<LongComplex> roots(N);
+    for (std::size_t j = 0UZ; j < N; ++j) {
+        roots[j] = std::polar(1.0L, -2.0L * std::numbers::pi_v<long double> * static_cast<long double>(j) / static_cast<long double>(N));
+    }
+    return roots;
+}
+
+template<typename T>
+std::vector<LongComplex> directDft(const std::vector<std::complex<T>>& x) {
+    const std::size_t        N     = x.size();
+    const auto               roots = rootsOfUnity(N);
+    std::vector<LongComplex> X(N);
+    for (std::size_t k = 0UZ; k < N; ++k) {
+        for (std::size_t n = 0UZ; n < N; ++n) {
+            X[k] += LongComplex(x[n]) * roots[(n * k) % N];
+        }
+    }
+    return X;
+}
+
+// iterative radix-2 Cooley-Tukey in long double: the ground truth above the sizes where the O(N^2) direct DFT is affordable
+template<typename T>
+std::vector<LongComplex> referenceFft(const std::vector<std::complex<T>>& x) {
+    const std::size_t N           = x.size();
+    const int         log2N       = std::countr_zero(N);
+    const auto        roots       = rootsOfUnity(N);
+    const auto        bitReversed = [log2N](std::size_t n) {
+        std::size_t reversed = 0UZ;
+        for (int bit = 0; bit < log2N; ++bit) {
+            reversed |= ((n >> bit) & 1UZ) << (log2N - 1 - bit);
+        }
+        return reversed;
+    };
+    std::vector<LongComplex> X(N);
+    for (std::size_t n = 0UZ; n < N; ++n) {
+        X[bitReversed(n)] = LongComplex(x[n]);
+    }
+    for (std::size_t half = 1UZ; half < N; half *= 2UZ) {
+        const std::size_t rootStep = N / (2UZ * half);
+        for (std::size_t block = 0UZ; block < N; block += 2UZ * half) {
+            for (std::size_t j = 0UZ; j < half; ++j) {
+                const LongComplex u = X[block + j];
+                const LongComplex v = X[block + j + half] * roots[j * rootStep];
+                X[block + j]        = u + v;
+                X[block + j + half] = u - v;
+            }
+        }
+    }
+    return X;
+}
+
+template<typename T>
+std::vector<LongComplex> groundTruth(const std::vector<std::complex<T>>& x) {
+    return x.size() <= 4096UZ ? directDft(x) : referenceFft(x);
+}
+
+template<typename T, typename U>
+long double relativeL2Error(const std::vector<std::complex<T>>& actual, const std::vector<std::complex<U>>& expected) {
+    long double errorSquared    = 0.0L;
+    long double expectedSquared = 0.0L;
+    for (std::size_t i = 0UZ; i < actual.size(); ++i) {
+        errorSquared += std::norm(LongComplex(actual[i]) - LongComplex(expected[i]));
+        expectedSquared += std::norm(LongComplex(expected[i]));
+    }
+    return std::sqrt(errorSquared / expectedSquared);
+}
+
+template<typename T>
+long double toleranceFor(std::size_t N) { // rounding error of an FFT grows with the number of passes, ~log2(N)
+    return 4.0L * static_cast<long double>(std::numeric_limits<T>::epsilon()) * std::log2(static_cast<long double>(N));
+}
+
+template<typename T>
+std::vector<std::complex<T>> stockhamForward(const std::vector<std::complex<T>>& in, std::span<const std::size_t> radices = {}) {
+    gr::algorithm::StockhamFFT<T> fft;
+    if (radices.empty()) {
+        fft.resize(in.size());
+    } else {
+        fft.resize(in.size(), radices);
+    }
+    std::vector<std::complex<T>> out(in.size());
+    fft.forward(in, out);
+    return out;
+}
+
+std::string planName(std::span<const std::size_t> radices) {
+    std::string name;
+    for (const std::size_t radix : radices) {
+        name += std::format("{}{}", name.empty() ? "" : "x", radix);
+    }
+    return name;
+}
+
+// every sequence of radices 2, 4, 8, 16 whose product is N, accepted by the predicate or not
+std::vector<std::vector<std::size_t>> radixSequences(std::size_t N) {
+    if (N == 1UZ) {
+        return {{}};
+    }
+    std::vector<std::vector<std::size_t>> sequences;
+    for (const std::size_t radix : {2UZ, 4UZ, 8UZ, 16UZ}) {
+        if (N % radix != 0UZ) {
+            continue;
+        }
+        for (auto tail : radixSequences(N / radix)) {
+            tail.insert(tail.begin(), radix);
+            sequences.push_back(std::move(tail));
+        }
+    }
+    return sequences;
+}
+
