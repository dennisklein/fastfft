+const boost::ut::suite<"StockhamFFT"> stockhamFFTTests = [] {
+    using namespace boost::ut;
+    using gr::algorithm::StockhamFFT;
+
+    if constexpr (!gr::algorithm::kStockhamFFTHasNativeSimd) {
+        skip / "StockhamFFT needs a native std::simd backend"_test = [] {};
+        return;
+    }
+
+    "the long-double reference FFT matches the long-double direct DFT"_test = [] {
+        for (std::size_t N = 2UZ; N <= 1024UZ; N *= 2UZ) {
+            const auto signal = randomSignal<double>(N);
+            expect(le(relativeL2Error(referenceFft(signal), directDft(signal)), 1e-17L)) << std::format("N={}", N);
+        }
+    };
+
+    "the default plan matches the long-double ground truth for every power-of-two size from 2^6 to 2^16"_test = []<typename T> {
+        for (std::size_t N = StockhamFFT<T>::kMinSize; N <= (1UZ << 16UZ); N *= 2UZ) {
+            const auto        signal = randomSignal<T>(N);
+            const long double error  = relativeL2Error(stockhamForward(signal), groundTruth(signal));
+            expect(le(error, toleranceFor<T>(N))) << std::format("N={} relative L2 error {:.3g}", N, static_cast<double>(error));
+        }
+    } | std::tuple<float, double>{};
+
+    "the default plan matches the long-double reference FFT at 2^20"_test = [] {
+        constexpr std::size_t N      = 1UZ << 20UZ;
+        const auto            signal = randomSignal<double>(N);
+        const long double     error  = relativeL2Error(stockhamForward(signal), referenceFft(signal));
+        expect(le(error, toleranceFor<double>(N))) << std::format("relative L2 error {:.3g}", static_cast<double>(error));
+    };
+
+    "every accepted plan matches the long-double ground truth"_test = []<typename T> {
+        for (const std::size_t N : {64UZ, 1024UZ, 8192UZ}) {
+            const auto  signal   = randomSignal<T>(N);
+            const auto  expected = groundTruth(signal);
+            std::size_t nPlans   = 0UZ;
+            for (const auto& radices : radixSequences(N)) {
+                if (!StockhamFFT<T>::isValidPlan(N, radices)) {
+                    continue;
+                }
+                ++nPlans;
+                const long double error = relativeL2Error(stockhamForward(signal, radices), expected);
+                expect(le(error, toleranceFor<T>(N))) << std::format("N={} plan {} relative L2 error {:.3g}", N, planName(radices), static_cast<double>(error));
+            }
+            expect(gt(nPlans, 1UZ)) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+
+    "the default plan is radix 8, then radix 16 while it fits, then the remainder"_test = [] {
+        expect(StockhamFFT<float>::defaultPlan(64UZ) == std::vector{8UZ, 8UZ});
+        expect(StockhamFFT<float>::defaultPlan(256UZ) == std::vector{8UZ, 16UZ, 2UZ});
+        expect(StockhamFFT<float>::defaultPlan(1UZ << 20UZ) == std::vector{8UZ, 16UZ, 16UZ, 16UZ, 16UZ, 2UZ});
+        for (std::size_t N = 64UZ; N <= (1UZ << 20UZ); N *= 2UZ) {
+            expect(StockhamFFT<float>::isValidPlan(N, StockhamFFT<float>::defaultPlan(N))) << std::format("N={}", N);
+        }
+    };
+
+    "plans the kernel cannot run are rejected by the predicate"_test = [] {
+        using Plan             = std::vector<std::size_t>;
+        constexpr auto isValid = [](std::size_t N, const Plan& radices) { return StockhamFFT<float>::isValidPlan(N, radices); };
+        expect(isValid(8192UZ, Plan{8UZ, 16UZ, 16UZ, 4UZ}));
+        expect(isValid(64UZ, Plan{8UZ, 2UZ, 4UZ}));
+        expect(!isValid(64UZ, Plan{})) << "empty";
+        expect(!isValid(32UZ, Plan{8UZ, 4UZ})) << "below the minimum size";
+        expect(!isValid(96UZ, Plan{8UZ, 12UZ})) << "not a power of two";
+        expect(!isValid(64UZ, Plan{16UZ, 4UZ})) << "first pass not radix 8";
+        expect(!isValid(64UZ, Plan{4UZ, 16UZ})) << "first pass not radix 8";
+        expect(!isValid(256UZ, Plan{8UZ, 32UZ})) << "radix 32";
+        expect(!isValid(64UZ, Plan{8UZ, 1UZ, 8UZ})) << "radix 1";
+        expect(!isValid(1024UZ, Plan{8UZ, 16UZ})) << "product below N";
+        expect(!isValid(64UZ, Plan{8UZ, 16UZ})) << "product above N";
+    };
+
+    "a unit impulse transforms to all ones"_test = []<typename T> {
+        for (const std::size_t N : {64UZ, 1024UZ, 1UZ << 16UZ}) {
+            std::vector<std::complex<T>> impulse(N);
+            impulse[0] = T(1);
+            const std::vector ones(N, std::complex<T>(1));
+            expect(le(relativeL2Error(stockhamForward(impulse), ones), toleranceFor<T>(N))) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+
+    "a complex tone at bin k transforms to N at bin k and zero elsewhere"_test = []<typename T> {
+        for (const std::size_t N : {64UZ, 4096UZ, 1UZ << 18UZ}) {
+            const std::size_t            bin   = N / 8UZ + 3UZ;
+            const auto                   roots = rootsOfUnity(N);
+            std::vector<std::complex<T>> tone(N);
+            for (std::size_t n = 0UZ; n < N; ++n) {
+                tone[n] = std::complex<T>(std::conj(roots[(bin * n) % N]));
+            }
+            std::vector<LongComplex> expected(N);
+            expected[bin] = static_cast<long double>(N);
+            expect(le(relativeL2Error(stockhamForward(tone), expected), toleranceFor<T>(N))) << std::format("N={}", N);
+        }
+    } | std::tuple<float, double>{};
+
+    "an in-place transform equals the out-of-place one for every plan"_test = []<typename T> {
+        constexpr std::size_t N = 2048UZ;
+        for (const auto& radices : radixSequences(N)) {
+            if (!StockhamFFT<T>::isValidPlan(N, radices)) {
