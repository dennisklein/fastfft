+            const bool                                           expectStockham = gr::algorithm::kStockhamFFTHasNativeSimd && N >= StockhamFFT<T>::kMinSize && route.kernel == FFTKernel::stockham;
+            const auto                                           signal         = randomSignal<T>(N);
+            gr::algorithm::FFT<std::complex<T>, std::complex<T>> fft;
+            std::vector<std::complex<T>>                         spectrum(N);
