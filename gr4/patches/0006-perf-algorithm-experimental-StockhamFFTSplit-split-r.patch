--- /dev/null
+++ b/algorithm/benchmarks/StockhamFFTSplit.hpp
@@ -0,0 +1,398 @@
+#ifndef GNURADIO_ALGORITHM_STOCKHAMFFTSPLIT_HPP
+#define GNURADIO_ALGORITHM_STOCKHAMFFTSPLIT_HPP
+
+#include <gnuradio-4.0/algorithm/fourier/StockhamFFT.hpp>
+
+namespace gr::algorithm {
+
+namespace detail {
+
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpsabi" // the kernel is always inlined, so the vector-argument ABI note does not apply
+#endif
+
+template<typename TVector>
+struct StockhamSplitKernel {
+    using V                        = TVector;
+    using T                        = typename V::value_type;
+    static constexpr std::size_t W = V::size();
+
+    struct Complex {
+        V re;
+        V im;
+
+        [[gnu::always_inline]] friend Complex operator+(const Complex& a, const Complex& b) { return {a.re + b.re, a.im + b.im}; }
+        [[gnu::always_inline]] friend Complex operator-(const Complex& a, const Complex& b) { return {a.re - b.re, a.im - b.im}; }
+    };
+
+    static constexpr T kInvSqrt2 = T(1) / std::numbers::sqrt2_v<T>;
+    static constexpr T kCosPi8   = T(0.92387953251128675613);
+    static constexpr T kSinPi8   = T(0.38268343236508977173);
+
+#if defined(__cpp_lib_simd) || defined(__glibcxx_simd)
+    [[gnu::always_inline]] static V    load(const T* p) { return std::simd::unchecked_load<V>(p, W); }
+    [[gnu::always_inline]] static void store(const V& v, T* p) { std::simd::unchecked_store(v, p, W); }
+
+    template<auto kSourceLane>
+    [[gnu::always_inline]] static V shuffle(const V& a, const V& b) {
+        return std::simd::permute<int(W)>(std::simd::cat(a, b), [](int j) { return int(kSourceLane(std::size_t(j))); });
+    }
+#else
+    // two-input shuffles through the compiler's generic vector type, as in StockhamKernel: vir has no two-input permute that compiles to one shuffle
+    typedef T GenericVector __attribute__((vector_size(sizeof(T) * W)));
+
+    [[gnu::always_inline]] static GenericVector toGeneric(const V& v) {
+        if constexpr (std::is_trivially_copyable_v<V> && sizeof(V) == sizeof(GenericVector)) {
+            return std::bit_cast<GenericVector>(v);
+        } else {
+            GenericVector r;
+            v.copy_to(reinterpret_cast<T*>(&r), vir::stdx::element_aligned);
+            return r;
+        }
+    }
+
+    [[gnu::always_inline]] static V fromGeneric(const GenericVector& g) {
+        if constexpr (std::is_trivially_copyable_v<V> && sizeof(V) == sizeof(GenericVector)) {
+            return std::bit_cast<V>(g);
+        } else {
+            return V(reinterpret_cast<const T*>(&g), vir::stdx::element_aligned);
+        }
+    }
+
+    [[gnu::always_inline]] static V    load(const T* p) { return V(p, vir::stdx::element_aligned); }
+    [[gnu::always_inline]] static void store(const V& v, T* p) { v.copy_to(p, vir::stdx::element_aligned); }
+
+    template<auto kSourceLane, std::size_t... J>
+    [[gnu::always_inline]] static V shuffle(const V& a, const V& b, std::index_sequence<J...>) {
+        return fromGeneric(__builtin_shufflevector(toGeneric(a), toGeneric(b), int(kSourceLane(J))...));
+    }
+    template<auto kSourceLane>
+    [[gnu::always_inline]] static V shuffle(const V& a, const V& b) {
+        return shuffle<kSourceLane>(a, b, std::make_index_sequence<W>{});
+    }
+#endif
+
+    [[gnu::always_inline]] static V zipLow(const V& a, const V& b) {
+        return shuffle<[](std::size_t j) { return (j & 1UZ) * W + j / 2UZ; }>(a, b);
+    }
+    [[gnu::always_inline]] static V zipHigh(const V& a, const V& b) {
+        return shuffle<[](std::size_t j) { return (j & 1UZ) * W + W / 2UZ + j / 2UZ; }>(a, b);
+    }
+
+    [[gnu::always_inline]] static Complex loadInterleaved(const T* p) {
+        const V low  = load(p);
+        const V high = load(p + W);
+        return {shuffle<[](std::size_t j) { return 2UZ * j; }>(low, high), shuffle<[](std::size_t j) { return 2UZ * j + 1UZ; }>(low, high)};
+    }
+    [[gnu::always_inline]] static void storeInterleaved(const Complex& z, T* p) {
+        store(zipLow(z.re, z.im), p);
+        store(zipHigh(z.re, z.im), p + W);
+    }
+
+    [[gnu::always_inline]] static Complex loadSplit(const T* p) { return {load(p), load(p + W)}; }
+    [[gnu::always_inline]] static void    storeSplit(const Complex& z, T* p) {
+        store(z.re, p);
+        store(z.im, p + W);
+    }
+
+    // a * b + c spelled out because vir::stdx::fma is not inlined by libstdc++; -ffp-contract fuses it
+    [[gnu::always_inline]] static Complex multiply(const Complex& z, const V& wRe, const V& wIm) { return {z.re * wRe - z.im * wIm, z.re * wIm + z.im * wRe}; }
+
+    [[gnu::always_inline]] static Complex multiplyMinusJ(const Complex& z) { return {z.im, -z.re}; }
+    [[gnu::always_inline]] static Complex multiplyW8(const Complex& z) { return {(z.re + z.im) * kInvSqrt2, (z.im - z.re) * kInvSqrt2}; }
+    [[gnu::always_inline]] static Complex multiplyW8Cubed(const Complex& z) { return {(z.im - z.re) * kInvSqrt2, (z.re + z.im) * -kInvSqrt2}; }
+
+    [[gnu::always_inline]] static void butterfly4(const Complex& a, const Complex& b, const Complex& c, const Complex& d, Complex& y0, Complex& y1, Complex& y2, Complex& y3) {
+        const Complex apc = a + c;
+        const Complex amc = a - c;
+        const Complex bpd = b + d;
+        const Complex bmd = b - d;
+        y0                = apc + bpd;
+        y2                = apc - bpd;
+        y1                = {amc.re + bmd.im, amc.im - bmd.re};
+        y3                = {amc.re - bmd.im, amc.im + bmd.re};
+    }
+
+    [[gnu::always_inline]] static void butterfly8(const Complex* a, Complex* y) {
+        const Complex b0 = a[0] + a[4];
+        const Complex b1 = a[1] + a[5];
+        const Complex b2 = a[2] + a[6];
+        const Complex b3 = a[3] + a[7];
+        const Complex c0 = a[0] - a[4];
+        const Complex c1 = multiplyW8(a[1] - a[5]);
+        const Complex c2 = multiplyMinusJ(a[2] - a[6]);
+        const Complex c3 = multiplyW8Cubed(a[3] - a[7]);
+        butterfly4(b0, b1, b2, b3, y[0], y[2], y[4], y[6]);
+        butterfly4(c0, c1, c2, c3, y[1], y[3], y[5], y[7]);
+    }
+
+    [[gnu::always_inline]] static void butterfly16(const Complex* a, Complex* y) {
+        Complex b[4][4];
+        for (std::size_t j = 0UZ; j < 4UZ; ++j) {
+            butterfly4(a[j], a[j + 4], a[j + 8], a[j + 12], b[j][0], b[j][1], b[j][2], b[j][3]);
+        }
+        b[1][1] = multiply(b[1][1], V(kCosPi8), V(-kSinPi8)); // W16^1
+        b[1][2] = multiplyW8(b[1][2]);
+        b[1][3] = multiply(b[1][3], V(kSinPi8), V(-kCosPi8)); // W16^3
+        b[2][1] = multiplyW8(b[2][1]);
+        b[2][2] = multiplyMinusJ(b[2][2]);
+        b[2][3] = multiplyW8Cubed(b[2][3]);
+        b[3][1] = multiply(b[3][1], V(kSinPi8), V(-kCosPi8)); // W16^3
+        b[3][2] = multiplyW8Cubed(b[3][2]);
+        b[3][3] = multiply(b[3][3], V(-kCosPi8), V(kSinPi8)); // W16^9
+        for (std::size_t k = 0UZ; k < 4UZ; ++k) {
+            butterfly4(b[0][k], b[1][k], b[2][k], b[3][k], y[k], y[k + 4], y[k + 8], y[k + 12]);
+        }
+    }
+
+    template<std::size_t radix>
+    [[gnu::always_inline]] static void butterfly(const Complex* a, Complex* y) {
+        if constexpr (radix == 2UZ) {
+            y[0] = a[0] + a[1];
+            y[1] = a[0] - a[1];
+        } else if constexpr (radix == 4UZ) {
+            butterfly4(a[0], a[1], a[2], a[3], y[0], y[1], y[2], y[3]);
+        } else if constexpr (radix == 8UZ) {
+            butterfly8(a, y);
+        } else {
+            butterfly16(a, y);
+        }
+    }
+
+    // lane j of v[k] moves to position radix * j + k of the radix * W concatenated outputs: log2(radix) perfect shuffles of the whole block
+    template<std::size_t radix>
+    [[gnu::always_inline]] static void transpose(V* v) {
+        for (std::size_t round = 0UZ; round < static_cast<std::size_t>(std::countr_zero(radix)); ++round) {
+            V shuffled[radix];
+            for (std::size_t u = 0UZ; u < radix / 2UZ; ++u) {
+                shuffled[2 * u]     = zipLow(v[u], v[u + radix / 2UZ]);
+                shuffled[2 * u + 1] = zipHigh(v[u], v[u + radix / 2UZ]);
+            }
+            std::copy_n(shuffled, radix, v);
+        }
+    }
+};
+
+#if defined(__GNUC__) && !defined(__clang__)
+#pragma GCC diagnostic pop
+#endif
+
+} // namespace detail
+
+/**
+ * Experimental variant of StockhamFFT (same contract) that keeps blocks of W real parts then W imaginary parts between passes, so products need no lane swaps.
+ * The first pass, vectorised over W butterflies, de-interleaves on load and transposes on store; the last pass re-interleaves on store.
+ * Plans need a first radix >= W lanes with N / radix >= W; on 16-lane targets N < 256 runs on half-width vectors.
+ */
+template<std::floating_point T>
+struct StockhamFFTSplit {
+#if defined(__cpp_lib_simd) || defined(__glibcxx_simd)
+    using V     = std::simd::vec<T>;
+    using VHalf = std::simd::vec<T, V::size() / 2UZ>;
+#else
+    using V     = vir::stdx::native_simd<T>;
+    using VHalf = vir::stdx::simd<T, vir::stdx::simd_abi::deduce_t<T, V::size() / 2UZ>>;
+#endif
+    static constexpr std::size_t kNativeLanes      = V::size();
+    static constexpr std::size_t kMinSize          = 64UZ;
+    static constexpr bool        kHasHalfWidthPath = kNativeLanes > 8UZ;             // 16 lanes need N >= 256 for a first radix of 16
+    static constexpr std::size_t kMiddleRadix      = sizeof(V) >= 64UZ ? 16UZ : 8UZ; // a split radix-16 butterfly needs 32 vector registers; quick unpaired check on one host, 2026-10-13
+    static_assert(kNativeLanes >= 2UZ && kNativeLanes <= 16UZ);
+
+    struct Pass {
+        std::size_t n;
+        std::size_t s;
+        std::size_t radix;
+        std::size_t twiddleOffset;
+    };
+
+    std::size_t                               _size{0UZ};
+    std::size_t                               _lanes{kNativeLanes};
+    std::vector<Pass>                         _passes;
+    std::vector<T>                            _twiddles;
+    std::vector<T, gr::allocator::Aligned<T>> _work;
+    std::vector<T, gr::allocator::Aligned<T>> _inPlaceWork;
+
+    [[nodiscard]] std::size_t size() const noexcept { return _size; }
+
+    [[nodiscard]] static constexpr bool isValidPlan(std::size_t N, std::span<const std::size_t> radices, std::size_t lanes) noexcept {
+        const auto isRadix = [](std::size_t radix) { return radix == 2UZ || radix == 4UZ || radix == 8UZ || radix == 16UZ; };
+        return N >= kMinSize && std::has_single_bit(N) && radices.size() >= 2UZ && std::ranges::all_of(radices, isRadix) && radices.front() >= std::max(lanes, 4UZ) && N / radices.front() >= lanes && std::ranges::fold_left(radices, 1UZ, std::multiplies{}) == N;
+    }
+
+    [[nodiscard]] static constexpr std::size_t lanesFor(std::size_t N, std::span<const std::size_t> radices) noexcept { return !kHasHalfWidthPath || isValidPlan(N, radices, kNativeLanes) ? kNativeLanes : VHalf::size(); }
+
+    [[nodiscard]] static std::vector<std::size_t> defaultPlan(std::size_t N) {
+        assert(N >= kMinSize && std::has_single_bit(N));
+        const std::size_t        lanes = !kHasHalfWidthPath || N >= kNativeLanes * kNativeLanes ? kNativeLanes : VHalf::size();
+        std::vector<std::size_t> radices{std::max(8UZ, lanes)};
+        for (std::size_t n = N / radices.front(); n > 1UZ; n /= radices.back()) {
+            radices.push_back(std::min(n, kMiddleRadix));
+        }
+        return radices;
+    }
+
+    void resize(std::size_t N) { resize(N, defaultPlan(N)); }
+
+    void resize(std::size_t N, std::span<const std::size_t> radices) {
+        _lanes = lanesFor(N, radices);
+        assert(isValidPlan(N, radices, _lanes));
+        const auto twiddle = [](std::size_t k, std::size_t n) { return std::polar(1.0, -2.0 * std::numbers::pi * static_cast<double>(k % n) / static_cast<double>(n)); };
+
+        _size = N;
+        _passes.clear();
+        _twiddles.clear();
+        std::size_t n = N;
+        std::size_t s = 1UZ;
+        for (const std::size_t radix : radices) {
+            const std::size_t m = n / radix;
+            _passes.push_back({n, s, radix, _twiddles.size()});
+            if (s == 1UZ) { // per group of _lanes butterflies, for k = 1..radix-1: _lanes real parts, then _lanes imaginary parts
+                for (std::size_t p0 = 0UZ; p0 < m; p0 += _lanes) {
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        for (std::size_t p = p0; p < p0 + _lanes; ++p) {
+                            _twiddles.push_back(static_cast<T>(twiddle(k * p, n).real()));
+                        }
+                        for (std::size_t p = p0; p < p0 + _lanes; ++p) {
+                            _twiddles.push_back(static_cast<T>(twiddle(k * p, n).imag()));
+                        }
+                    }
+                }
+            } else if (m > 1UZ) { // per butterfly p, for k = 1..radix-1: (re, im), broadcast at use
+                for (std::size_t p = 0UZ; p < m; ++p) {
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        const auto w = twiddle(k * p, n);
+                        _twiddles.insert(_twiddles.end(), {static_cast<T>(w.real()), static_cast<T>(w.imag())});
+                    }
+                }
+            }
+            n = m;
+            s *= radix;
+        }
+        _work.resize(2UZ * N);
+        _inPlaceWork.resize(2UZ * N);
+    }
+
+    void forward(std::span<const std::complex<T>> in, std::span<std::complex<T>> out) {
+        assert(in.size() == _size && out.size() == _size);
+        if constexpr (kHasHalfWidthPath) {
+            if (_lanes != kNativeLanes) {
+                run<VHalf>(reinterpret_cast<const T*>(in.data()), reinterpret_cast<T*>(out.data()));
+                return;
+            }
+        }
+        run<V>(reinterpret_cast<const T*>(in.data()), reinterpret_cast<T*>(out.data()));
+    }
+
+    // a split buffer holds blocks of W real parts followed by the W imaginary parts of the same values; out serves as one unless the call is in place
+    template<typename TVector>
+    void run(const T* x, T* y) {
+        const std::size_t nPasses  = _passes.size();
+        T*                partner  = x == y ? _inPlaceWork.data() : y;
+        const T*          splitSrc = nullptr;
+        for (std::size_t i = 0UZ; i + 1UZ < nPasses; ++i) {
+            const bool intoWork = (nPasses - 2UZ - i) % 2UZ == 0UZ; // the pass before the last must not write to out
+            T*         dst      = intoWork ? _work.data() : partner;
+            if (i == 0UZ) {
+                runFirstPass<TVector>(_passes[i], x, dst);
+            } else {
+                runStridedPass<TVector, false>(_passes[i], splitSrc, dst);
+            }
+            splitSrc = dst;
+        }
+        runStridedPass<TVector, true>(_passes.back(), splitSrc, y);
+    }
+
+    template<typename TVector>
+    void runFirstPass(const Pass& pass, const T* x, T* y) const {
+        switch (pass.radix) {
+        case 4UZ: runFirstPass<TVector, 4UZ>(pass, x, y); return;
+        case 8UZ: runFirstPass<TVector, 8UZ>(pass, x, y); return;
+        case 16UZ: runFirstPass<TVector, 16UZ>(pass, x, y); return;
+        default: std::unreachable();
+        }
+    }
+
+    template<typename TVector, std::size_t radix>
+    void runFirstPass(const Pass& pass, const T* x, T* y) const {
+        using Kernel                                 = detail::StockhamSplitKernel<TVector>;
+        using Complex                                = typename Kernel::Complex;
+        constexpr std::size_t W                      = Kernel::W;
+        constexpr std::size_t kTwiddleValuesPerGroup = (radix - 1UZ) * 2UZ * W;
+        const std::size_t     m                      = pass.n / radix;
+        const T*              t                      = _twiddles.data() + pass.twiddleOffset;
+        for (std::size_t p0 = 0UZ; p0 < m; p0 += W, t += kTwiddleValuesPerGroup) {
+            Complex a[radix], o[radix];
+            for (std::size_t k = 0UZ; k < radix; ++k) {
+                a[k] = Kernel::loadInterleaved(x + 2 * (p0 + k * m));
+            }
+            Kernel::template butterfly<radix>(a, o);
+            TVector re[radix], im[radix];
+            re[0] = o[0].re;
+            im[0] = o[0].im;
+            for (std::size_t k = 1UZ; k < radix; ++k) {
+                const Complex product = Kernel::multiply(o[k], Kernel::load(t + 2 * W * (k - 1)), Kernel::load(t + 2 * W * (k - 1) + W));
+                re[k]                 = product.re;
+                im[k]                 = product.im;
+            }
+            Kernel::template transpose<radix>(re);
+            Kernel::template transpose<radix>(im);
+            for (std::size_t i = 0UZ; i < radix; ++i) {
+                Kernel::storeSplit({re[i], im[i]}, y + 2 * (radix * p0 + W * i));
+            }
+        }
+    }
+
+    template<typename TVector, bool intoInterleaved>
+    void runStridedPass(const Pass& pass, const T* x, T* y) const {
+        switch (pass.radix) {
+        case 2UZ: runStridedPass<TVector, intoInterleaved, 2UZ>(pass, x, y); return;
+        case 4UZ: runStridedPass<TVector, intoInterleaved, 4UZ>(pass, x, y); return;
+        case 8UZ: runStridedPass<TVector, intoInterleaved, 8UZ>(pass, x, y); return;
+        case 16UZ: runStridedPass<TVector, intoInterleaved, 16UZ>(pass, x, y); return;
+        default: std::unreachable();
+        }
+    }
+
+    // intoInterleaved: the last pass (m = 1, no twiddles), writing std::complex<T> values
+    template<typename TVector, bool intoInterleaved, std::size_t radix>
+    void runStridedPass(const Pass& pass, const T* x, T* y) const {
+        using Kernel                                     = detail::StockhamSplitKernel<TVector>;
+        using Complex                                    = typename Kernel::Complex;
+        constexpr std::size_t W                          = Kernel::W;
+        constexpr std::size_t kTwiddleValuesPerButterfly = 2UZ * (radix - 1UZ);
+        const std::size_t     s                          = pass.s;
+        const std::size_t     m                          = pass.n / radix;
+        for (std::size_t p = 0UZ; p < m; ++p) {
+            const T* t  = _twiddles.data() + pass.twiddleOffset + kTwiddleValuesPerButterfly * p;
+            const T* xp = x + 2 * s * p;
+            T*       yp = y + 2 * s * radix * p;
+            for (std::size_t q = 0UZ; q < s; q += W) {
+                Complex a[radix], o[radix];
+                for (std::size_t k = 0UZ; k < radix; ++k) {
+                    a[k] = Kernel::loadSplit(xp + 2 * (q + k * s * m));
+                }
+                Kernel::template butterfly<radix>(a, o);
+                if constexpr (intoInterleaved) {
+                    for (std::size_t k = 0UZ; k < radix; ++k) {
+                        Kernel::storeInterleaved(o[k], yp + 2 * (q + k * s));
+                    }
+                } else {
+                    if (p != 0UZ) {
+                        for (std::size_t k = 1UZ; k < radix; ++k) {
+                            o[k] = Kernel::multiply(o[k], TVector(t[2 * (k - 1)]), TVector(t[2 * (k - 1) + 1]));
+                        }
+                    }
+                    for (std::size_t k = 0UZ; k < radix; ++k) {
+                        Kernel::storeSplit(o[k], yp + 2 * (q + k * s));
+                    }
+                }
+            }
+        }
+    }
+};
+
+} // namespace gr::algorithm
+
+#endif // GNURADIO_ALGORITHM_STOCKHAMFFTSPLIT_HPP
-- 
