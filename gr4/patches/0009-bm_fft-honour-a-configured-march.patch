From 8ff2f9bfd2e400afb6af83f278b43d53a6f3a693 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 15:34:31 +0000
Subject: [PATCH 09/11] bm_fft: honour a configured -march

---
 algorithm/benchmarks/CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/algorithm/benchmarks/CMakeLists.txt b/algorithm/benchmarks/CMakeLists.txt
index a6a64b3..814dedd 100644
--- a/algorithm/benchmarks/CMakeLists.txt
+++ b/algorithm/benchmarks/CMakeLists.txt
@@ -20,6 +20,9 @@ function(add_gr_benchmark BM_NAME)
       target_compile_options(${BM_NAME} PRIVATE -mrelaxed-simd)
       target_link_options(${BM_NAME} PRIVATE -mrelaxed-simd)
     endif()
+  elseif(CMAKE_CXX_FLAGS MATCHES "-march=")
+    # a configured target (e.g. a distribution's baseline) is measured as built, not as this host's best
+    target_compile_options(${BM_NAME} PRIVATE -O2)
   else()
     target_compile_options(${BM_NAME} PRIVATE -O2 -march=native)
   endif()
-- 
