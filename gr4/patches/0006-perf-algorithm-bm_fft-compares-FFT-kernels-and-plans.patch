+template<typename T>
+std::vector<std::complex<long double>> referenceSpectrum(std::span<const std::complex<T>> x) {
+    using LC            = std::complex<long double>;
+    const std::size_t N = x.size();
+    std::vector<LC>   twiddles(N);
+    for (std::size_t n = 0UZ; n < N; ++n) {
+        twiddles[n] = std::polar(1.0L, -2.0L * std::numbers::pi_v<long double> * static_cast<long double>(n) / static_cast<long double>(N));
+    }
+
+    std::vector<LC> spectrum(N);
+    if (N <= kDirectDFTMaxN) {
+        for (std::size_t k = 0UZ; k < N; ++k) {
+            for (std::size_t n = 0UZ; n < N; ++n) {
+                spectrum[k] += LC(x[n]) * twiddles[(n * k) % N];
+            }
+        }
+        return spectrum;
+    }
+
+    const unsigned log2N = static_cast<unsigned>(std::countr_zero(N));
+    for (std::size_t n = 0UZ; n < N; ++n) {
+        std::size_t reversed = 0UZ;
+        for (unsigned bit = 0U; bit < log2N; ++bit) {
+            reversed |= ((n >> bit) & 1UZ) << (log2N - 1U - bit);
+        }
+        spectrum[reversed] = LC(x[n]);
+    }
+    for (std::size_t length = 2UZ; length <= N; length *= 2UZ) {
+        const std::size_t half = length / 2UZ;
+        const std::size_t step = N / length;
+        for (std::size_t start = 0UZ; start < N; start += length) {
+            for (std::size_t j = 0UZ; j < half; ++j) {
+                const LC u                 = spectrum[start + j];
+                const LC v                 = spectrum[start + j + half] * twiddles[j * step];
+                spectrum[start + j]        = u + v;
+                spectrum[start + j + half] = u - v;
+            }
         }
     }
-    return signal;
+    return spectrum;
 }
 
