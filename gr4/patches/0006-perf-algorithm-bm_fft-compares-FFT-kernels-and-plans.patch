+long double relativeL2Error(std::span<const std::complex<T>> got, const std::vector<std::complex<long double>>& reference) {
+    long double errorSum = 0.0L;
+    long double normSum  = 0.0L;
+    for (std::size_t i = 0UZ; i < got.size(); ++i) {
+        errorSum += std::norm(std::complex<long double>(got[i]) - reference[i]);
+        normSum += std::norm(reference[i]);
+    }
+    return std::sqrt(errorSum / normSum);
