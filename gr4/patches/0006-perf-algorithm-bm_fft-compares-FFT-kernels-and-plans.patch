+template<typename T>
+std::vector<Candidate> makeCandidates(std::size_t N) {
+    std::vector<Candidate> candidates;
+    if (std::has_single_bit(N)) {
+        auto simd = std::make_shared<SimdFFT<T, Transform::Complex>>();
+        simd->resize(N);
+        candidates.push_back({.name = "SimdFFT", .kernel = FFTKernel::simdFft, .run = [simd, N](std::span<const std::byte> in, std::span<std::byte> out) { simd->template transform<Direction::Forward, Order::Ordered>(std::span<const T>(reinterpret_cast<const T*>(in.data()), 2UZ * N), std::span<T>(reinterpret_cast<T*>(out.data()), 2UZ * N)); }});
+
+        const auto defaultPlan = StockhamFFT<T>::defaultPlan(N);
+        auto       stockham    = std::make_shared<StockhamFFT<T>>();
+        stockham->resize(N);
+        candidates.push_back({.name = planName(defaultPlan) + " default", .kernel = FFTKernel::stockham, .plan = defaultPlan, .isDefaultPlan = true, .run = forwardOf<T>(stockham)});
+
+        for (auto& plan : alternativePlans(N)) {
+            auto kernel = std::make_shared<StockhamFFT<T>>();
+            kernel->resize(N, plan);
+            candidates.push_back({.name = planName(plan), .kernel = FFTKernel::stockham, .plan = plan, .run = forwardOf<T>(kernel)});
+        }
+
+#if __has_include("StockhamFFTSplit.hpp")
+        {
+            auto kernel = std::make_shared<StockhamFFTSplit<T>>();
+            kernel->resize(N);
+            candidates.push_back({.name = "Split", .run = forwardOf<T>(kernel)});
+        }
+#endif
+    }
+
+    auto dispatcher = std::make_shared<FFT<std::complex<T>>>();
+    candidates.push_back({.name = "FFT", .run = [dispatcher](std::span<const std::byte> in, std::span<std::byte> out) {
+                              auto input  = std::span<const std::complex<T>>(reinterpret_cast<const std::complex<T>*>(in.data()), in.size() / sizeof(std::complex<T>));
+                              auto output = std::span<std::complex<T>>(reinterpret_cast<std::complex<T>*>(out.data()), out.size() / sizeof(std::complex<T>));
+                              dispatcher->compute(input, output);
+                          }});
+    return candidates;
