+std::string planName(std::span<const std::size_t> plan) {
+    std::string name = "Stockham";
+    for (std::size_t i = 0UZ; i < plan.size(); ++i) {
+        name += i == 0UZ ? " " : "·";
+        name += std::to_string(plan[i]);
+    }
+    return name;
