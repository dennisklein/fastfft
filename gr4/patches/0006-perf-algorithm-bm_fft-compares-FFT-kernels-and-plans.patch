+using Cases      = std::vector<::benchmark::comparison_case>;
+using Statistics = std::vector<::benchmark::case_statistics>;
+
+template<std::size_t ROUNDS, std::size_t K>
+Statistics compareK(std::string_view name, const Cases& cases, std::size_t scale, std::chrono::nanoseconds minSample) {
+    if (cases.size() == K) {
+        return [&]<std::size_t... I>(std::index_sequence<I...>) { return ::benchmark::compare<ROUNDS>(name, {cases[I]...}, scale, minSample); }(std::make_index_sequence<K>{});
+    }
+    if constexpr (K > 1UZ) {
+        return compareK<ROUNDS, K - 1UZ>(name, cases, scale, minSample);
+    } else {
+        std::unreachable();
+    }
+}
+
+Statistics compareGroup(std::string_view name, const Cases& cases, std::size_t scale, const Settings& settings) {
+    const auto minSample = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::milliseconds(settings.minSampleMs));
+    const auto choice    = std::min(static_cast<std::size_t>(std::ranges::find_if(kRoundChoices, [&](std::size_t rounds) { return rounds >= settings.rounds; }) - kRoundChoices.begin()), kRoundChoices.size() - 1UZ);
+    Statistics result;
+    [&]<std::size_t... I>(std::index_sequence<I...>) { ((I == choice ? (result = compareK<kRoundChoices[I], kMaxCases>(name, cases, scale, minSample), 0) : 0), ...); }(std::make_index_sequence<kRoundChoices.size()>{});
+    return result;
+}
