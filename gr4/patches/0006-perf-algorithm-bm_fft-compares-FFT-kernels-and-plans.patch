+// reorderings and single splits of the default plan, taken alternately so that both kinds appear when the cap is small
+std::vector<std::vector<std::size_t>> alternativePlans(std::size_t N) {
+    using Plan                    = std::vector<std::size_t>;
+    const Plan        defaultPlan = StockhamFFT<double>::defaultPlan(N);
+    const auto        isValid     = [N](const Plan& plan) { return StockhamFFT<double>::isValidPlan(N, plan); };
+    Plan              tail        = Plan(defaultPlan.begin() + 1, defaultPlan.end());
+    std::set<Plan>    seen{defaultPlan};
+    std::vector<Plan> reorderings;
+    std::vector<Plan> splits;
+
+    std::ranges::sort(tail);
+    do {
+        Plan plan{defaultPlan.front()};
+        plan.insert(plan.end(), tail.begin(), tail.end());
+        if (seen.insert(plan).second) {
+            reorderings.push_back(plan);
+        }
+    } while (std::ranges::next_permutation(tail).found);
+
+    for (std::size_t i = defaultPlan.size(); i-- > 1UZ;) {
+        for (const std::size_t a : {2UZ, 4UZ, 8UZ}) {
+            if (defaultPlan[i] % a != 0UZ || defaultPlan[i] == a) {
+                continue;
+            }
+            Plan plan = defaultPlan;
+            plan[i]   = a;
+            plan.insert(plan.begin() + static_cast<std::ptrdiff_t>(i) + 1, defaultPlan[i] / a);
+            if (isValid(plan) && seen.insert(plan).second) {
+                splits.push_back(plan);
+            }
+        }
+    }
+
+    std::vector<Plan> chosen;
+    for (std::size_t i = 0UZ; chosen.size() < kMaxPlans && (i < reorderings.size() || i < splits.size()); ++i) {
+        for (const auto* source : {&reorderings, &splits}) {
+            if (i < source->size() && chosen.size() < kMaxPlans && isValid((*source)[i])) {
+                chosen.push_back((*source)[i]);
+            }
+        }
+    }
+    return chosen;
+}
