+template<typename T, typename Kernel>
+auto forwardOf(std::shared_ptr<Kernel> kernel) {
+    return [kernel](std::span<const std::byte> in, std::span<std::byte> out) { kernel->forward({reinterpret_cast<const std::complex<T>*>(in.data()), in.size() / sizeof(std::complex<T>)}, {reinterpret_cast<std::complex<T>*>(out.data()), out.size() / sizeof(std::complex<T>)}); };
