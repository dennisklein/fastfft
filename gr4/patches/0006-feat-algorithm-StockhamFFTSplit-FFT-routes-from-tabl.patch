+
+/**
+ * Variant of StockhamFFT (same contract) that keeps blocks of W real parts then W imaginary parts between passes, so products need no lane swaps.
+ * The first pass, vectorised over W butterflies, de-interleaves on load and transposes on store; the last pass re-interleaves on store.
+ * FFT routes large sizes here at 128- and 256-bit vectors, where it was measured faster than every interleaved plan (FFTRoutes.hpp).
+ * Plans need a first radix >= W lanes with N / radix >= W; on 16-lane targets N < 256 runs on half-width vectors.
+ */
+template<std::floating_point T>
+struct StockhamFFTSplit {
+#if defined(__cpp_lib_simd) || defined(__glibcxx_simd)
+    using V     = std::simd::vec<T>;
+    using VHalf = std::simd::vec<T, std::max(V::size() / 2UZ, 1UZ)>;
+#else
+    using V     = vir::stdx::native_simd<T>;
+    using VHalf = vir::stdx::simd<T, vir::stdx::simd_abi::deduce_t<T, std::max(V::size() / 2UZ, 1UZ)>>;
+#endif
+    static constexpr std::size_t kNativeLanes      = V::size();
+    static constexpr std::size_t kMinSize          = 64UZ;
+    static constexpr bool        kHasHalfWidthPath = kNativeLanes > 8UZ;             // 16 lanes need N >= 256 for a first radix of 16
+    static constexpr std::size_t kMiddleRadix      = sizeof(V) >= 64UZ ? 16UZ : 8UZ; // a split radix-16 butterfly needs 32 vector registers; quick unpaired check on one host, 2026-10-13
+
+    struct Pass {
+        std::size_t n;
+        std::size_t s;
+        std::size_t radix;
+        std::size_t twiddleOffset;
+    };
+
+    std::size_t                               _size{0UZ};
+    std::size_t                               _lanes{kNativeLanes};
+    std::vector<Pass>                         _passes;
+    std::vector<T>                            _twiddles;
+    std::vector<T, gr::allocator::Aligned<T>> _work;
+    std::vector<T, gr::allocator::Aligned<T>> _inPlaceWork;
+
+    [[nodiscard]] std::size_t size() const noexcept { return _size; }
+
+    [[nodiscard]] static constexpr bool isValidPlan(std::size_t N, std::span<const std::size_t> radices, std::size_t lanes) noexcept {
+        const auto isRadix = [](std::size_t radix) { return radix == 2UZ || radix == 4UZ || radix == 8UZ || radix == 16UZ; };
+        return N >= kMinSize && std::has_single_bit(N) && radices.size() >= 2UZ && std::ranges::all_of(radices, isRadix) && radices.front() >= std::max(lanes, 4UZ) && N / radices.front() >= lanes && std::ranges::fold_left(radices, 1UZ, std::multiplies{}) == N;
+    }
+
+    [[nodiscard]] static constexpr std::size_t lanesFor(std::size_t N, std::span<const std::size_t> radices) noexcept { return !kHasHalfWidthPath || isValidPlan(N, radices, kNativeLanes) ? kNativeLanes : VHalf::size(); }
+
+    [[nodiscard]] static std::vector<std::size_t> defaultPlan(std::size_t N) {
+        assert(N >= kMinSize && std::has_single_bit(N));
+        const std::size_t        lanes = !kHasHalfWidthPath || N >= kNativeLanes * kNativeLanes ? kNativeLanes : VHalf::size();
+        std::vector<std::size_t> radices{std::max(8UZ, lanes)};
+        for (std::size_t n = N / radices.front(); n > 1UZ; n /= radices.back()) {
+            radices.push_back(std::min(n, kMiddleRadix));
+        }
+        return radices;
+    }
+
+    void resize(std::size_t N) { resize(N, defaultPlan(N)); }
+
+    void resize(std::size_t N, std::span<const std::size_t> radices) {
+        static_assert(kNativeLanes >= 2UZ && kNativeLanes <= 16UZ);
+        _lanes = lanesFor(N, radices);
+        assert(isValidPlan(N, radices, _lanes));
+        const auto twiddle = [](std::size_t k, std::size_t n) { return std::polar(1.0, -2.0 * std::numbers::pi * static_cast<double>(k % n) / static_cast<double>(n)); };
+
+        _size = N;
+        _passes.clear();
+        _twiddles.clear();
+        std::size_t n = N;
+        std::size_t s = 1UZ;
+        for (const std::size_t radix : radices) {
+            const std::size_t m = n / radix;
+            _passes.push_back({n, s, radix, _twiddles.size()});
+            if (s == 1UZ) { // per group of _lanes butterflies, for k = 1..radix-1: _lanes real parts, then _lanes imaginary parts
+                for (std::size_t p0 = 0UZ; p0 < m; p0 += _lanes) {
+#pragma GCC unroll 16
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        for (std::size_t p = p0; p < p0 + _lanes; ++p) {
+                            _twiddles.push_back(static_cast<T>(twiddle(k * p, n).real()));
+                        }
+                        for (std::size_t p = p0; p < p0 + _lanes; ++p) {
+                            _twiddles.push_back(static_cast<T>(twiddle(k * p, n).imag()));
+                        }
+                    }
+                }
+            } else if (m > 1UZ) { // per butterfly p, for k = 1..radix-1: (re, im), broadcast at use
+                for (std::size_t p = 0UZ; p < m; ++p) {
+#pragma GCC unroll 16
+                    for (std::size_t k = 1UZ; k < radix; ++k) {
+                        const auto w = twiddle(k * p, n);
+                        _twiddles.insert(_twiddles.end(), {static_cast<T>(w.real()), static_cast<T>(w.imag())});
+                    }
+                }
+            }
+            n = m;
+            s *= radix;
+        }
+        _work.resize(2UZ * N);
+        _inPlaceWork.resize(2UZ * N);
+    }
+
+    void forward(std::span<const std::complex<T>> in, std::span<std::complex<T>> out) {
+        assert(in.size() == _size && out.size() == _size);
+        if constexpr (kHasHalfWidthPath) {
+            if (_lanes != kNativeLanes) {
+                run<VHalf>(reinterpret_cast<const T*>(in.data()), reinterpret_cast<T*>(out.data()));
+                return;
+            }
+        }
+        run<V>(reinterpret_cast<const T*>(in.data()), reinterpret_cast<T*>(out.data()));
+    }
+
+    // a split buffer holds blocks of W real parts followed by the W imaginary parts of the same values; out serves as one unless the call is in place
+    template<typename TVector>
+    void run(const T* x, T* y) {
+        const std::size_t nPasses  = _passes.size();
+        T*                partner  = x == y ? _inPlaceWork.data() : y;
+        const T*          splitSrc = nullptr;
+        for (std::size_t i = 0UZ; i + 1UZ < nPasses; ++i) {
+            const bool intoWork = (nPasses - 2UZ - i) % 2UZ == 0UZ; // the pass before the last must not write to out
+            T*         dst      = intoWork ? _work.data() : partner;
+            if (i == 0UZ) {
+                runFirstPass<TVector>(_passes[i], x, dst);
+            } else {
+                runStridedPass<TVector, false>(_passes[i], splitSrc, dst);
+            }
+            splitSrc = dst;
+        }
+        runStridedPass<TVector, true>(_passes.back(), splitSrc, y);
+    }
+
+    template<typename TVector>
+    void runFirstPass(const Pass& pass, const T* x, T* y) const {
+        switch (pass.radix) {
+        case 4UZ: runFirstPass<TVector, 4UZ>(pass, x, y); return;
+        case 8UZ: runFirstPass<TVector, 8UZ>(pass, x, y); return;
+        case 16UZ: runFirstPass<TVector, 16UZ>(pass, x, y); return;
+        default: std::unreachable();
+        }
+    }
+
+    template<typename TVector, std::size_t radix>
+    void runFirstPass(const Pass& pass, const T* x, T* y) const {
+        using Kernel                                 = detail::StockhamSplitKernel<TVector>;
+        using Complex                                = typename Kernel::Complex;
+        constexpr std::size_t W                      = Kernel::W;
+        constexpr std::size_t kTwiddleValuesPerGroup = (radix - 1UZ) * 2UZ * W;
+        const std::size_t     m                      = pass.n / radix;
+        const T*              t                      = _twiddles.data() + pass.twiddleOffset;
+        for (std::size_t p0 = 0UZ; p0 < m; p0 += W, t += kTwiddleValuesPerGroup) {
+            Complex a[radix], o[radix];
+#pragma GCC unroll 16
+            for (std::size_t k = 0UZ; k < radix; ++k) {
+                a[k] = Kernel::loadInterleaved(x + 2 * (p0 + k * m));
+            }
+            Kernel::template butterfly<radix>(a, o);
+            TVector re[radix], im[radix];
+            re[0] = o[0].re;
+            im[0] = o[0].im;
+#pragma GCC unroll 16
+            for (std::size_t k = 1UZ; k < radix; ++k) {
+                const Complex product = Kernel::multiply(o[k], Kernel::load(t + 2 * W * (k - 1)), Kernel::load(t + 2 * W * (k - 1) + W));
+                re[k]                 = product.re;
+                im[k]                 = product.im;
+            }
+            Kernel::template transpose<radix>(re);
+            Kernel::template transpose<radix>(im);
+#pragma GCC unroll 16
+            for (std::size_t i = 0UZ; i < radix; ++i) {
+                Kernel::storeSplit({re[i], im[i]}, y + 2 * (radix * p0 + W * i));
+            }
+        }
+    }
+
+    template<typename TVector, bool intoInterleaved>
+    void runStridedPass(const Pass& pass, const T* x, T* y) const {
+        switch (pass.radix) {
+        case 2UZ: runStridedPass<TVector, intoInterleaved, 2UZ>(pass, x, y); return;
+        case 4UZ: runStridedPass<TVector, intoInterleaved, 4UZ>(pass, x, y); return;
+        case 8UZ: runStridedPass<TVector, intoInterleaved, 8UZ>(pass, x, y); return;
+        case 16UZ: runStridedPass<TVector, intoInterleaved, 16UZ>(pass, x, y); return;
+        default: std::unreachable();
+        }
+    }
+
+    // intoInterleaved: the last pass (m = 1, no twiddles), writing std::complex<T> values
+    template<typename TVector, bool intoInterleaved, std::size_t radix>
+    void runStridedPass(const Pass& pass, const T* x, T* y) const {
+        using Kernel                                     = detail::StockhamSplitKernel<TVector>;
+        using Complex                                    = typename Kernel::Complex;
+        constexpr std::size_t W                          = Kernel::W;
+        constexpr std::size_t kTwiddleValuesPerButterfly = 2UZ * (radix - 1UZ);
+        const std::size_t     s                          = pass.s;
+        const std::size_t     m                          = pass.n / radix;
+        for (std::size_t p = 0UZ; p < m; ++p) {
+            const T* t  = _twiddles.data() + pass.twiddleOffset + kTwiddleValuesPerButterfly * p;
+            const T* xp = x + 2 * s * p;
+            T*       yp = y + 2 * s * radix * p;
+            for (std::size_t q = 0UZ; q < s; q += W) {
+                Complex a[radix], o[radix];
+#pragma GCC unroll 16
+                for (std::size_t k = 0UZ; k < radix; ++k) {
+                    a[k] = Kernel::loadSplit(xp + 2 * (q + k * s * m));
+                }
+                Kernel::template butterfly<radix>(a, o);
+                if constexpr (intoInterleaved) {
+#pragma GCC unroll 16
+                    for (std::size_t k = 0UZ; k < radix; ++k) {
+                        Kernel::storeInterleaved(o[k], yp + 2 * (q + k * s));
+                    }
+                } else {
+                    if (p != 0UZ) {
+#pragma GCC unroll 16
+                        for (std::size_t k = 1UZ; k < radix; ++k) {
+                            o[k] = Kernel::multiply(o[k], TVector(t[2 * (k - 1)]), TVector(t[2 * (k - 1) + 1]));
+                        }
+                    }
+#pragma GCC unroll 16
+                    for (std::size_t k = 0UZ; k < radix; ++k) {
+                        Kernel::storeSplit(o[k], yp + 2 * (q + k * s));
+                    }
+                }
+            }
+        }
+    }
+};
+
+} // namespace gr::algorithm
