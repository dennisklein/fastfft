+namespace {
+
+__extension__ using Count = unsigned __int128;
+
+// P(B <= k) * 2^n for B ~ binomial(n, 1/2), from Pascal's triangle in exact integers
+Count scaledBinomialCdf(std::size_t n, std::size_t k) {
+    std::vector<Count> row(n + 1, 0);
+    row[0] = 1;
+    for (std::size_t m = 1; m <= n; ++m) {
+        for (std::size_t j = m; j > 0; --j) {
+            row[j] += row[j - 1];
+        }
+    }
+    Count sum = 0;
+    for (std::size_t j = 0; j <= k; ++j) {
+        sum += row[j];
+    }
+    return sum;
+}
+
+bool tailAtMostHalfMiss(std::size_t n, std::size_t k) { return scaledBinomialCdf(n, k) * 40 <= (Count{1} << n); }
+
+} // namespace
+
+const boost::ut::suite<"benchmark statistics"> tests = [] {
+    using namespace boost::ut;
