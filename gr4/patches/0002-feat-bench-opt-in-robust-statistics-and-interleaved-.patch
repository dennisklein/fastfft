+struct comparison_case {
+    std::string                      name;
+    std::function<void(std::size_t)> run_calls;
+
+    template<typename Callable>
+    requires std::invocable<Callable&>
+    comparison_case(std::string caseName, Callable callable)
+        : name(std::move(caseName)), run_calls([callable = std::move(callable)](std::size_t calls) mutable {
+              for (std::size_t i = 0; i < calls; ++i) {
+                  callable();
+              }
+          }) {}
+};
+
+struct case_statistics {
+    std::string                      name;
+    std::size_t                      calls_per_sample{};
+    std::vector<double>              seconds_per_call; // one entry per round
+    utils::robust_statistics<double> time;
+    utils::robust_statistics<double> ratio_to_reference; // same-round ratio to the first case
+};
+
+/**
+ * Measures the cases in ROUNDS rounds; each round times one sample of every case in a freshly
+ * shuffled order, so slow drifts hit all cases equally. The first case is the reference. A case
+ * beats the reference only if ratio_to_reference.ci_high < 1, and loses if ci_low > 1.
+ *
+ *   const auto stats = ::benchmark::compare<40>("fft 1024", {{"reference", [&] { a(); }}, {"candidate", [&] { b(); }}}, 1024);
+ */
+template<std::size_t ROUNDS, typename ResultType = results>
+requires(ROUNDS > 0)
+std::vector<case_statistics> compare(std::string_view name, std::initializer_list<comparison_case> cases, std::size_t n_scale_results = 1LU, std::chrono::nanoseconds minSample = std::chrono::milliseconds{5}) {
+    std::vector<case_statistics> statistics(cases.size());
+    std::vector<std::size_t>     order(cases.size());
+    std::ranges::copy(std::views::iota(std::size_t{0}, cases.size()), order.begin());
+    for (const auto index : order) {
+        const auto& testCase   = *(cases.begin() + static_cast<std::ptrdiff_t>(index));
+        auto&       entry      = statistics[index];
+        entry.name             = testCase.name;
+        entry.calls_per_sample = detail::calibrate_calls(testCase.run_calls, minSample);
+        entry.seconds_per_call.resize(ROUNDS);
+        detail::time_sample(testCase.run_calls, entry.calls_per_sample); // warm-up sample, discarded
+    }
+
+    std::mt19937_64 shuffler{0x6772'3472}; // fixed seed keeps the run order reproducible
+    for (std::size_t round = 0; round < ROUNDS; ++round) {
+        std::ranges::shuffle(order, shuffler);
+        for (const auto index : order) {
+            auto& entry                   = statistics[index];
+            entry.seconds_per_call[round] = detail::time_sample((cases.begin() + static_cast<std::ptrdiff_t>(index))->run_calls, entry.calls_per_sample) / static_cast<double>(entry.calls_per_sample);
+        }
+    }
+
+    for (auto& entry : statistics) {
+        entry.time               = utils::compute_robust_statistics(entry.seconds_per_call);
+        entry.ratio_to_reference = utils::compute_ratio_statistics(entry.seconds_per_call, statistics.front().seconds_per_call);
+
+        auto& resultMap = ResultType::add_result(std::format("{}: {}", name, entry.name));
+        resultMap.try_emplace("#N", ROUNDS, "", 0);
+        detail::add_sample_columns(resultMap, entry.seconds_per_call, entry.calls_per_sample, n_scale_results, 0);
+        resultMap.try_emplace("ratio", std::format("{:.3f}", entry.ratio_to_reference.median), "", 0);
+        resultMap.try_emplace("ratio CI95", std::format("[{:.3f}, {:.3f}]", entry.ratio_to_reference.ci_low, entry.ratio_to_reference.ci_high), "", 0);
+    }
+    return statistics;
+}
