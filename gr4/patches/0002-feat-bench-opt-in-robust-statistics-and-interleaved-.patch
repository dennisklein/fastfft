+
+    "median of odd and even sample counts"_test = [] {
+        expect(eq(median_of_sorted<double>(std::array{1.0, 2.0, 7.0}), 2.0));
+        expect(eq(median_of_sorted<double>(std::array{1.0, 2.0, 3.0, 4.0}), 2.5));
+        expect(eq(median_of_sorted<double>(std::array{5.0}), 5.0));
+        expect(std::isnan(median_of_sorted<double>(std::span<const double>{})));
+    };
+
+    "median and relative MAD of an unsorted sample with an outlier"_test = [] {
+        const auto stats = compute_robust_statistics<double>({100.0, 3.0, 1.0, 4.0, 2.0});
+        expect(eq(stats.median, 3.0));
+        // deviations 2, 1, 0, 1, 97 have median 1
+        expect(eq(stats.rel_mad, 1.0 / 3.0));
+    };
+
+    "even sample count averages the middle pair for median and MAD"_test = [] {
+        const auto stats = compute_robust_statistics<double>({4.0, 1.0, 3.0, 2.0, 10.0, 12.0});
+        expect(eq(stats.median, 3.5));
+        // deviations 2.5, 0.5, 0.5, 1.5, 6.5, 8.5 have median (1.5 + 2.5) / 2
+        expect(eq(stats.rel_mad, 2.0 / 3.5));
+    };
+
+    "median interval ranks match the exact binomial tail"_test = [](std::size_t n) {
+        const auto [lower, upper] = median_ci_ranks(n);
+        expect(eq(lower + upper, n + 1));
+        expect(lower >= 1_u);
+        expect(tailAtMostHalfMiss(n, lower - 1)) << "lower rank must not exceed the tail budget";
+        expect(!tailAtMostHalfMiss(n, lower)) << "next rank would exceed the tail budget";
+    } | std::vector<std::size_t>{40, 120, 7, 41, 1000 / 10};
