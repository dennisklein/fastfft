+template<std::floating_point T>
+struct robust_statistics {
+    T median{std::numeric_limits<T>::quiet_NaN()};
+    T ci_low{std::numeric_limits<T>::quiet_NaN()};  // 95 % interval of the median
+    T ci_high{std::numeric_limits<T>::quiet_NaN()}; // 95 % interval of the median
+    T rel_mad{std::numeric_limits<T>::quiet_NaN()}; // median absolute deviation / median
+};
+
+template<std::floating_point T>
+[[nodiscard]] constexpr T median_of_sorted(std::span<const T> sorted) noexcept {
+    const std::size_t n = sorted.size();
+    if (n == 0) {
+        return std::numeric_limits<T>::quiet_NaN();
+    }
+    return n % 2 == 1 ? sorted[n / 2] : (sorted[n / 2 - 1] + sorted[n / 2]) / 2;
+}
+
+/**
+ * 1-based ranks {lower, upper} of the order statistics that bracket the median of n samples with
+ * at least the given confidence: the largest lower rank whose binomial(n, 1/2) tail does not
+ * exceed half the miss probability. Below n = 6 no rank qualifies, so the full range is returned.
+ */
+[[nodiscard]] inline std::pair<std::size_t, std::size_t> median_ci_ranks(std::size_t n, double confidence = 0.95) {
+    if (n == 0) {
+        return {0, 0};
+    }
+    const double tail      = 0.5 * (1.0 - confidence);
+    const double dn        = static_cast<double>(n);
+    double       cdf       = 0.0;
+    std::size_t  lowerRank = 1;
+    for (std::size_t k = 0; k < n; ++k) {
+        const double dk = static_cast<double>(k);
+        cdf += std::exp(std::lgamma(dn + 1.0) - std::lgamma(dk + 1.0) - std::lgamma(dn - dk + 1.0) - dn * std::numbers::ln2);
+        if (cdf > tail) {
+            break;
+        }
+        lowerRank = k + 1;
+    }
+    return {lowerRank, n + 1 - lowerRank};
+}
+
+template<std::floating_point T>
+[[nodiscard]] robust_statistics<T> compute_robust_statistics(std::vector<T> values) {
+    if (values.empty()) {
+        return {};
+    }
+    std::ranges::sort(values);
+    const T median         = median_of_sorted<T>(values);
+    const auto [low, high] = median_ci_ranks(values.size());
+    std::vector<T> deviations(values.size());
+    std::ranges::transform(values, deviations.begin(), [median](T v) { return std::abs(v - median); });
+    std::ranges::sort(deviations);
+    return {median, values[low - 1], values[high - 1], median_of_sorted<T>(deviations) / median};
+}
+
+template<std::floating_point T>
+[[nodiscard]] robust_statistics<T> compute_ratio_statistics(const std::vector<T>& numerator, const std::vector<T>& denominator) {
+    assert(numerator.size() == denominator.size());
+    std::vector<T> ratios(numerator.size());
+    std::ranges::transform(numerator, denominator, ratios.begin(), std::divides<>{});
+    return compute_robust_statistics(std::move(ratios));
+}
+
