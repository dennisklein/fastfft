+namespace detail {
+
+using sample_clock = std::chrono::steady_clock;
+
+template<typename RunCalls>
+double time_sample(RunCalls& runCalls, std::size_t calls) {
+    const auto start = sample_clock::now();
+    runCalls(calls);
+    return std::chrono::duration<double>(sample_clock::now() - start).count();
+}
+
+template<typename RunCalls>
+std::size_t calibrate_calls(RunCalls& runCalls, std::chrono::nanoseconds minSample) {
+    const double minSampleSeconds = std::chrono::duration<double>(minSample).count();
+    std::size_t  calls            = 1;
+    while (time_sample(runCalls, calls) < minSampleSeconds) {
+        calls *= 2;
+    }
+    return calls;
+}
+
+inline std::string format_interval(const utils::robust_statistics<double>& stats, std::size_t digits) { return std::format("[{}, {}]", utils::to_si_prefix(stats.ci_low, "s", digits), utils::to_si_prefix(stats.ci_high, "s", digits)); }
